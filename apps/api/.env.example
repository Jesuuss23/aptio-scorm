# Copia este archivo como .env en apps/api. DATABASE_URL se toma de packages/db/.env si no se define aquí.
API_PORT=3000
WEB_URL=http://localhost:5173
REDIS_HOST=localhost
REDIS_PORT=6379
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=aptio-scorm-assets
# Clave KMS con la que se cifra todo archivo (HU-1404). En local la crea `pnpm almacen:preparar`.
KMS_KEY_ID=alias/aptio-documentos
# Sesión (HU-0104). En producción SESSION_SECRET es obligatorio: genera uno con `openssl rand -base64 48`.
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Correo (HU-0109). Mailpit de docker-compose; la bandeja se ve en http://localhost:8025.
# Sin SMTP_URL, los correos se escriben en el registro de la API.
SMTP_URL=smtp://localhost:1025
CORREO_REMITENTE=no-responder@aptio.test
# Colas (HU-0105). El prefijo debe ser el mismo en la API y el worker.
COLAS_PREFIJO=aptio
# simulado: POST /trabajos/simulados encola trabajos con las salidas del caso LOTO.
PROVEEDORES_MODO=simulado
# Voz de Google para la muestra (HU-0205) fuera del modo simulado. Clave de API restringida a Text-to-Speech; nunca en el repositorio.
GOOGLE_TTS_API_KEY=
# HU-1304 · Voz de ElevenLabs (Conexiones IA). Solo en el entorno: nunca en la base ni en el repositorio.
ELEVENLABS_API_KEY=
# Ingreso con Google (HU-0108), solo para correos invitados. Cliente OAuth «Aplicación web» de Google Cloud; nunca en el repositorio.
# Sin estas variables el botón vuelve a Ingresar con «aún no está configurado». La URI de retorno se registra igual en Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# HU-1201 · Límite de subida (MB) para advertir si el cliente no tiene ficha de compatibilidad. Nunca bloquea.
LIMITE_SUBIDA_REFERENCIA_MB=100
