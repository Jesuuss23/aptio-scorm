# Copia este archivo como .env en apps/worker. DATABASE_URL se toma de packages/db/.env si no se define aquí.
REDIS_HOST=localhost
REDIS_PORT=6379
# Prefijo de las claves de BullMQ; debe ser el mismo en la API y el worker.
COLAS_PREFIJO=aptio
# simulado: salidas grabadas del caso LOTO, sin red ni costo. real: llama a la API de Anthropic (HU-0405).
PROVEEDORES_MODO=simulado
# Clave de la API de Anthropic para el modo real; nunca en el repositorio.
ANTHROPIC_API_KEY=
# Modelo por variable de los prompts (packages/ai/prompts). Vacío = claude-opus-5-5.
ANTHROPIC_MODEL_TEXTO=
ANTHROPIC_MODEL_RAPIDO=
ANTHROPIC_MODEL_PANTALLAS=
# Esfuerzo de razonamiento: low, medium (por defecto), high, xhigh o max.
ANTHROPIC_ESFUERZO=medium
# Demora total del trabajo simulado, para ver el avance en la web.
SIMULADO_DEMORA_MS=2000
WORKER_CONCURRENCIA=2
# Almacenamiento (HU-1404): el worker borra los documentos del cliente vencidos cada día a las 3:00.
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=aptio-scorm-assets
KMS_KEY_ID=alias/aptio-documentos
