# Copia este archivo como .env en apps/worker. DATABASE_URL se toma de packages/db/.env si no se define aquí.
REDIS_HOST=localhost
REDIS_PORT=6379
# Prefijo de las claves de BullMQ; debe ser el mismo en la API y el worker.
COLAS_PREFIJO=aptio
# En el S0 solo existe el modo simulado (salidas grabadas del caso LOTO).
PROVEEDORES_MODO=simulado
# Demora total del trabajo simulado, para ver el avance en la web.
SIMULADO_DEMORA_MS=2000
WORKER_CONCURRENCIA=2
# Almacenamiento (HU-1404): el worker borra los documentos del cliente vencidos cada día a las 3:00.
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=aptio-scorm-assets
KMS_KEY_ID=alias/aptio-documentos
