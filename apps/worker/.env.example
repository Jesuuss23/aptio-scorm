# Copia este archivo como .env en apps/worker. DATABASE_URL se toma de packages/db/.env si no se define aquí.
REDIS_HOST=localhost
REDIS_PORT=6379
# Prefijo de las claves de BullMQ; debe ser el mismo en la API y el worker.
COLAS_PREFIJO=aptio
# simulado: salidas grabadas del caso LOTO, sin red ni costo. real: llama a la API de Anthropic (HU-0405).
PROVEEDORES_MODO=simulado
# Clave de la API de Anthropic para el modo real; nunca en el repositorio.
ANTHROPIC_API_KEY=
# Modelo por variable de los prompts (packages/ai/prompts). Vacío = claude-opus-5-5.
ANTHROPIC_MODEL_TEXTO=
ANTHROPIC_MODEL_RAPIDO=
ANTHROPIC_MODEL_PANTALLAS=
# Esfuerzo de razonamiento: low, medium (por defecto), high, xhigh o max.
ANTHROPIC_ESFUERZO=medium
# Transcripción de video y audio (HU-0305) en modo real: Google Speech-to-Text v1. En modo simulado no se usa.
GOOGLE_STT_API_KEY=
# Modelo de reconocimiento; vacío = latest_long.
GOOGLE_STT_MODELO=
# Voz de la narración (HU-0701) en modo real: Google Text-to-Speech con la voz del kit. En modo simulado se genera silencio y no se usa.
GOOGLE_TTS_API_KEY=
# HU-1304 · Voz de ElevenLabs (Conexiones IA). Solo en el entorno: nunca en la base ni en el repositorio.
ELEVENLABS_API_KEY=
# Boca del personaje (HU-0702) en modo real: ruta del ejecutable de Rhubarb Lip Sync 1.13; vacío = «rhubarb» en el PATH.
# Usa ffmpeg para pasar el MP3 a WAV. En modo simulado las bocas salen del texto y no se usa.
RHUBARB_PATH=
# Demora total del trabajo simulado, para ver el avance en la web.
SIMULADO_DEMORA_MS=2000
WORKER_CONCURRENCIA=2
# Almacenamiento (HU-1404): el worker borra los documentos del cliente vencidos cada día a las 3:00.
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=aptio-scorm-assets
KMS_KEY_ID=alias/aptio-documentos
# Copia de seguridad diaria a las 3:00 de Lima (HU-1403): volcado de PostgreSQL y copia de los objetos al bucket de
# respaldos, con 14 días de retención. PG_BIN_DIR fija la versión de pg_dump (la del servidor, 16).
S3_BUCKET_RESPALDOS=aptio-scorm-respaldos
# PG_BIN_DIR=/usr/lib/postgresql/16/bin
# Aviso por correo del límite de gasto (HU-1403). Sin SMTP_URL se escribe en el registro del worker.
SMTP_URL=smtp://localhost:1025
CORREO_REMITENTE=no-responder@aptio.test
# HU-1505 · Entorno del sitio: en `produccion` la publicación programada espera mientras haya datos ficticios visibles.
# Si falta, se toma `produccion`. En local y en el entorno de pruebas va `pruebas`.
SITIO_ENTORNO=pruebas
# HU-1508 · Pre-render del sitio (DA-08): dominio para canonical y sitemap, y la base de las rutas.
SITIO_URL=https://aptioscorm.com
SITIO_BASE=/s
