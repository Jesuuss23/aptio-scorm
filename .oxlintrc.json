{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "import",
    "vitest"
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.generado.ts",
    "**/test-results/**",
    "**/cdk.out/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "vitest/expect-expect": [
      "warn",
      {
        "assertFunctionNames": [
          "expect",
          "expect*",
          "*.hasResourceProperties",
          "*.resourceCountIs",
          "*.resourcePropertiesCountIs",
          "*.hasResource"
        ]
      }
    ]
  }
}
