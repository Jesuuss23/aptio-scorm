{
  "name": "aptio-scorm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:infra": "docker compose up -d",
    "stop:infra": "docker compose down",
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "db:migrate": "pnpm --filter @aptio/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @aptio/db exec prisma db seed",
    "schema:test": "node docs/04-modelo-contenido/pruebas.mjs",
    "ia:casos": "node packages/ai/scripts/validar-casos.mjs && node docs/04-modelo-contenido/validar.mjs packages/ai/casos/loto/curso-esperado-es.json",
    "openapi:lint": "npx @redocly/cli lint docs/api/openapi.yaml",
    "db:test": "pnpm --filter @aptio/db test"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
