{
  "name": "aptio-scorm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:infra": "docker compose up -d",
    "stop:infra": "docker compose down",
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "db:migrate": "pnpm --filter @aptio/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @aptio/db exec prisma db seed",
    "schema:test": "pnpm --filter @aptio/schema test",
    "ia:casos": "node packages/ai/scripts/validar-casos.mjs && pnpm --filter @aptio/schema validar packages/ai/casos/loto/curso-esperado-es.json",
    "openapi:lint": "npx -y @redocly/cli@2.77.0 lint docs/api/openapi.yaml",
    "almacen:preparar": "pnpm --filter @aptio/almacen preparar",
    "db:test": "pnpm --filter @aptio/db test",
    "web:e2e": "pnpm --filter web e2e",
    "lint": "oxlint --deny-warnings apps packages",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @aptio/db generate",
    "db:deploy": "pnpm --filter @aptio/db exec prisma migrate deploy",
    "ci": "pnpm lint && pnpm db:generate && pnpm typecheck && pnpm test && pnpm ia:casos"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "oxlint": "^1.93.0",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "wasm-feature-detect": "1.8.0"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0"
}
