                      "tipo": {
                        "enum": [
                          "portada",
                          "objetivos",
                          "contenido",
                          "actividad",
                          "evaluacion",
                          "seccion",
                          "resumen",
                          "resultados",
                          "cierre"
                        ]
                      },
                      "proposito": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "objetivoIds": {
                        "type": "array",
                        "items": {
                          "$ref": "https://aulaseducativas.local/esquemas/curso/v0.json#/$defs/id"
                        },
                        "minItems": 0
