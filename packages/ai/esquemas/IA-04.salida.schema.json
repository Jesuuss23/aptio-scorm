    "objetivos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "https://aulaseducativas.local/esquemas/curso/v0.json#/$defs/id"
          },
          "texto": {
            "$ref": "https://aulaseducativas.local/esquemas/curso/v0.json#/$defs/textoI18n"
          },
          "nivelBloom": {
            "enum": [
              "recordar",
              "comprender",
              "aplicar",
              "analizar",
              "evaluar",
              "crear"
            ]
          },
          "verbo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          }
        },
        "required": [
          "id",
          "texto",
          "nivelBloom",
          "verbo"
        ]
