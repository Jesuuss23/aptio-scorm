    "modulos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "https://aulaseducativas.local/esquemas/curso/v0.json#/$defs/id"
          },
          "titulo": {
            "$ref": "https://aulaseducativas.local/esquemas/curso/v0.json#/$defs/textoI18n"
          },
          "capsulas": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "https://aulaseducativas.local/esquemas/curso/v0.json#/$defs/id"
                },
                "titulo": {
                  "$ref": "https://aulaseducativas.local/esquemas/curso/v0.json#/$defs/textoI18n"
                },
                "objetivoIds": {
                  "type": "array",
                  "items": {
                    "$ref": "https://aulaseducativas.local/esquemas/curso/v0.json#/$defs/id"
                  },
                  "minItems": 1
                },
                "duracionEstimadaMin": {
                  "type": "number",
