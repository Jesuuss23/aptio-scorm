{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aulaseducativas.local/esquemas/ia/IA-18.json",
  "title": "IA-18 · Extracción de kit (salida)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "paleta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primario": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "secundario": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "acento": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "texto": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "fondo": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "primario",
        "secundario",
        "acento",
        "texto",
        "fondo"
      ]
    },
    "tipografias": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "titulos": {
          "enum": [
            "Barlow Condensed",
            "Montserrat",
            "Poppins",
            "Merriweather",
            "Plus Jakarta Sans",
            "Atkinson Hyperlegible",
            "Open Sans",
            "Nunito",
            "Lato",
            "Source Sans 3"
          ],
          "description": "De la lista cerrada del kit (FUENTES_KIT, SIL OFL)"
        },
        "texto": {
          "enum": [
            "Barlow Condensed",
            "Montserrat",
            "Poppins",
            "Merriweather",
            "Plus Jakarta Sans",
            "Atkinson Hyperlegible",
            "Open Sans",
            "Nunito",
            "Lato",
            "Source Sans 3"
          ],
          "description": "De la lista cerrada del kit (FUENTES_KIT, SIL OFL)"
        },
        "alternativasLibres": {
          "type": "array",
          "items": {
            "enum": [
              "Barlow Condensed",
              "Montserrat",
              "Poppins",
              "Merriweather",
              "Plus Jakarta Sans",
              "Atkinson Hyperlegible",
              "Open Sans",
              "Nunito",
              "Lato",
              "Source Sans 3"
            ]
          },
          "minItems": 0,
          "maxItems": 4
        }
      },
      "required": [
        "titulos",
        "texto"
      ]
    },
    "tipografiaMarca": {
      "type": "object",
      "additionalProperties": false,
      "description": "Las tipografías que usa la marca, aunque no sean libres (HU-0206)",
      "properties": {
        "titulos": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "texto": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "required": [
        "titulos",
        "texto"
      ]
    },
    "estilo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ilustracion": {
          "enum": [
            "plana",
            "lineal",
            "isometrica",
            "semirrealista",
            "fotografia"
          ]
        },
        "esquinas": {
          "enum": [
            "rectas",
            "suaves",
            "redondeadas"
          ]
        },
        "tono": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kit": {
          "enum": [
            "Industrial",
            "Corporativo",
            "Institucional",
            "Infantil aula",
            "Salud"
          ],
          "description": "Estilo base del kit (ESTILOS_KIT)"
        }
      },
      "required": [
        "ilustracion",
        "esquinas",
        "tono",
        "kit"
      ]
    },
    "contrasteOk": {
      "type": "boolean",
      "description": "texto sobre fondo y blanco sobre primario cumplen 4,5:1"
    },
    "evidencias": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 1,
      "maxItems": 10
    },
    "confianza": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "paleta",
    "tipografias",
    "tipografiaMarca",
    "estilo",
    "contrasteOk",
    "evidencias",
    "confianza"
  ]
}
