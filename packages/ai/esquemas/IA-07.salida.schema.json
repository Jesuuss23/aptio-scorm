{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aulaseducativas.local/esquemas/ia/IA-07.json",
  "title": "IA-07 · Datos de una interacción (salida)",
  "type": "object",
  "additionalProperties": false,
