{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aulaseducativas.local/esquemas/ia/IA-19.json",
  "title": "IA-19 · Propuestas de contenido para SEO de IA (salida)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "propuestas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/pagina" },
          { "$ref": "#/$defs/pregunta" }
        ]
      }
    },
    "observaciones": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "maxLength": 300 }
    }
  },
  "required": ["propuestas"],
  "$defs": {
    "pagina": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "pagina" },
        "titulo": { "type": "string", "minLength": 3, "maxLength": 120 },
        "ruta": { "type": "string", "maxLength": 200, "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$" },
        "metaTitulo": { "type": "string", "minLength": 3, "maxLength": 60 },
        "metaDescripcion": { "type": "string", "minLength": 20, "maxLength": 160 },
        "motivo": { "type": "string", "minLength": 10, "maxLength": 300 }
      },
      "required": ["tipo", "titulo", "ruta", "metaTitulo", "metaDescripcion", "motivo"]
    },
    "pregunta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tipo": { "const": "pregunta" },
        "pregunta": { "type": "string", "minLength": 5, "maxLength": 200 },
        "respuesta": { "type": "string", "minLength": 20, "maxLength": 800 },
        "pagina": { "type": "string", "maxLength": 200, "pattern": "^/(?:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*)?$" },
        "motivo": { "type": "string", "minLength": 10, "maxLength": 300 }
      },
      "required": ["tipo", "pregunta", "respuesta", "motivo"]
    }
  }
}
