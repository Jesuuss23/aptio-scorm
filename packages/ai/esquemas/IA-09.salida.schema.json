{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aulaseducativas.local/esquemas/ia/IA-09.json",
  "title": "IA-09 · Pausas y preguntas de video (salida, v2)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "duracionMs": {
      "type": "integer",
      "minimum": 1
    },
    "cambiosTema": {
      "description": "HU-0903 · Los momentos en que la transcripción cambia de tema (sin el inicio del video), en orden.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tiempoMs",
          "tema"
        ],
        "properties": {
          "tiempoMs": {
            "type": "integer",
            "minimum": 1
          },
          "tema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "marcadores": {
      "type": "array",
      "items": {
        "$ref": "https://aulaseducativas.local/esquemas/curso/v0.json#/$defs/marcadorVideo"
      },
      "minItems": 1,
      "maxItems": 12
    },
    "observaciones": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "minItems": 0,
      "maxItems": 10
    }
  },
  "required": [
    "duracionMs",
    "cambiosTema",
    "marcadores"
  ]
}
