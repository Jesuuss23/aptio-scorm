        "velocidad": 1.0
      },
      "recursoAudioId": "aud-p28-es",
      "subtitulosId": "vtt-p28-es"
    },
    {
      "pantallaId": "p29",
      "texto": "Estos son tus resultados.",
      "hashTexto": "da8d08fe8445594b14c034f0ff9fc26fc944972491d1892490719aca6a9be511",
      "duracionMs": 1625,
      "voz": {
