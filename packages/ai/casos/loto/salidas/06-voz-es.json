        "velocidad": 1.0
      },
      "recursoAudioId": "aud-p29-es",
      "subtitulosId": "vtt-p29-es"
    },
    {
      "pantallaId": "p30",
      "texto": "¡Lo lograste! Ya sabes bloquear y etiquetar de forma segura.",
      "hashTexto": "d8c7ab860f3680172c34ee19cedc27b5989b2bc7ca92888ac162120129254ba6",
      "duracionMs": 3900,
