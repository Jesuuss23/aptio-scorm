  "narraciones": [
    {
      "pantallaId": "p01",
      "texto": "Hola, te doy la bienvenida a esta cápsula sobre bloqueo y etiquetado.",
      "hashTexto": "e973259adc8c51317c5260dfeb2278b9d4c3cf265b8f0d4135c25b14931195b8",
      "duracionMs": 4485,
      "voz": {
