                {
                  "id": "p05-af-2",
                  "texto": {
                    "es": "Un resorte tenso puede mover una pieza sin aviso."
                  },
                  "verdadera": true,
                  "retroalimentacion": {
                    "es": "Realidad: guarda energía mecánica."
                  }
                },
                {
                  "id": "p05-af-3",
                  "texto": {
                    "es": "Si la máquina no se mueve, no tiene energía."
                  },
                  "verdadera": false,
                  "retroalimentacion": {
                    "es": "Mito: puede quedar energía guardada."
                  }
                },
                {
                  "id": "p05-af-4",
                  "texto": {
                    "es": "El vapor de una tubería apagada puede quemarte."
                  },
                  "verdadera": true,
                  "retroalimentacion": {
                    "es": "Realidad: la energía térmica sigue ahí hasta que se enfría."
                  }
                }
              ]
            }
          }
        }
      }
