        },
        "alt": {
          "$ref": "#/$defs/textoI18n"
        },
        "puntos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "x",
              "y",
              "titulo",
              "contenido",
              "obligatorio"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "titulo": {
                "$ref": "#/$defs/textoI18n"
              },
              "contenido": {
                "$ref": "#/$defs/textoI18n"
              },
              "obligatorio": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "datosDeslizar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afirmaciones"
      ],
      "properties": {
        "afirmaciones": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "texto",
              "verdadera",
              "retroalimentacion"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "texto": {
                "$ref": "#/$defs/textoI18n"
              },
              "verdadera": {
                "type": "boolean"
              },
              "retroalimentacion": {
                "$ref": "#/$defs/textoI18n"
              }
            }
          }
        }
      }
    },
    "datosDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inicioId",
        "nodos"
      ],
      "properties": {
        "inicioId": {
          "$ref": "#/$defs/id"
        },
        "nodos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "situacion",
              "opciones"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "situacion": {
                "$ref": "#/$defs/textoI18n"
              },
              "opciones": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "texto",
                    "consecuencia",
                    "puntaje"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "texto": {
                      "$ref": "#/$defs/textoI18n"
                    },
                    "consecuencia": {
                      "$ref": "#/$defs/textoI18n"
                    },
                    "recursoId": {
                      "$ref": "#/$defs/id"
                    },
                    "puntaje": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "siguienteId": {
                      "$ref": "#/$defs/id"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "marcadorVideo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tiempoMs",
        "tipo",
        "obligatorio"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tiempoMs": {
          "type": "integer",
          "minimum": 0
        },
        "tipo": {
          "enum": [
            "pregunta",
            "punto",
            "capitulo"
          ]
        },
        "obligatorio": {
          "type": "boolean"
        },
        "pregunta": {
          "$ref": "#/$defs/preguntaQuiz"
        },
        "titulo": {
          "$ref": "#/$defs/textoI18n"
        },
        "contenido": {
          "$ref": "#/$defs/textoI18n"
        },
        "posicion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "origen": {
          "$ref": "#/$defs/origen"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "pregunta"
              }
            }
          },
          "then": {
            "required": [
              "pregunta"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "punto"
              }
            }
          },
          "then": {
            "required": [
              "titulo",
              "contenido",
              "posicion"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "capitulo"
              }
            }
          },
          "then": {
            "required": [
              "titulo"
            ]
          }
        }
      ]
    },
    "bloque": {
      "type": "object",
      "required": [
        "id",
        "tipo"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tipo": {
          "enum": [
            "texto",
            "imagen",
            "personaje",
            "interaccion",
            "video"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "texto"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "rol",
              "contenido",
              "origen"
            ],
            "properties": {
              "id": true,
              "tipo": true,
              "rol": {
                "enum": [
                  "titulo",
                  "subtitulo",
                  "cuerpo",
                  "destacado"
                ]
              },
              "contenido": {
                "$ref": "#/$defs/textoI18n"
              },
              "origen": {
                "$ref": "#/$defs/origen"
              },
              "animacion": {
                "$ref": "#/$defs/animacion"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "imagen"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "recursoId",
              "decorativa"
            ],
            "properties": {
              "id": true,
              "tipo": true,
              "recursoId": {
                "$ref": "#/$defs/id"
              },
              "decorativa": {
                "type": "boolean"
              },
              "alt": {
                "$ref": "#/$defs/textoI18n"
              },
              "animacion": {
                "$ref": "#/$defs/animacion"
              },
              "origen": {
                "$ref": "#/$defs/origen"
              }
            },
            "if": {
              "properties": {
                "decorativa": {
                  "const": false
                }
              }
            },
            "then": {
              "required": [
                "alt"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "personaje"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "recursoId"
            ],
            "properties": {
              "id": true,
              "tipo": true,
              "recursoId": {
                "$ref": "#/$defs/id",
                "description": "SVG del personaje con capas boca_A..boca_X"
              },
              "pose": {
                "enum": [
                  "explicando",
                  "celebrando",
                  "pensando",
                  "advirtiendo",
                  "neutral"
                ]
              },
              "lado": {
                "enum": [
                  "izquierda",
                  "derecha"
                ]
              },
              "animacion": {
                "$ref": "#/$defs/animacion"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "interaccion"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "interaccion"
            ],
            "properties": {
              "id": true,
              "tipo": true,
              "interaccion": {
                "$ref": "#/$defs/interaccion"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "video"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "recursoId",
              "marcadores",
              "reglas"
            ],
            "properties": {
              "id": true,
              "tipo": true,
              "recursoId": {
                "$ref": "#/$defs/id"
              },
              "subtitulos": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "es": {
                    "$ref": "#/$defs/id"
                  },
                  "en": {
                    "$ref": "#/$defs/id"
                  }
                }
              },
              "marcadores": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/marcadorVideo"
                }
              },
              "reglas": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "impedirAdelantar",
                  "porcentajeMinimo"
                ],
                "properties": {
                  "impedirAdelantar": {
                    "type": "boolean"
                  },
                  "porcentajeMinimo": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pantalla": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titulo",
        "tipo",
        "plantilla",
        "estado",
        "obligatoria",
        "bloques"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "titulo": {
          "$ref": "#/$defs/textoI18n"
        },
        "tipo": {
          "enum": [
            "portada",
            "contenido",
            "interactiva",
            "evaluacion",
            "video",
            "cierre"
          ]
        },
        "objetivoIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "nivelBloom": {
          "description": "Nivel de Bloom de la pantalla para la alineación (HU-1001). Si falta, se toma el de su disposición.",
          "enum": [
            "recordar",
            "comprender",
            "aplicar",
            "analizar",
            "evaluar",
            "crear"
          ]
        },
        "plantilla": {
          "type": "string",
          "description": "id de plantilla de pantalla del estilo del kit"
        },
        "estado": {
          "$ref": "#/$defs/estadoContenido"
        },
        "obligatoria": {
          "type": "boolean"
        },
        "bloques": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bloque"
          }
        },
        "narracion": {
          "$ref": "#/$defs/narracion"
        },
        "fondoRecursoId": {
          "$ref": "#/$defs/id"
        },
        "disposicion": {
          "description": "Composición de la pantalla generada (v0.2). La define el generador a partir de las pantallas modelo del kit; el editor puede cambiarla.",
          "enum": [
            "portada",
            "objetivos",
            "personaje",
            "dato",
            "idea",
            "lista",
            "memoria",
            "clasificar",
            "ordenar",
            "decision",
            "video",
            "hotspot",
            "quiz",
            "vf",
            "resumen",
            "seccion",
            "resultados",
            "cierre"
          ]
        },
        "fondo": {
          "description": "Color de fondo de la pantalla como rol del kit (v0.2).",
          "$ref": "#/$defs/rolColor"
        },
        "ajustes": {
          "description": "Retoques del editor por elemento (clave = id del bloque o del elemento de la disposición). Se guardan aparte del contenido para que la IA pueda regenerar textos sin perderlos (v0.2).",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ajusteElemento"
          }
        },
        "extras": {
          "description": "Elementos agregados a mano en el editor sobre la pantalla generada (v0.2).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/elementoExtra"
          }
        }
      }
    },
    "rolColor": {
      "enum": [
        "primario",
        "secundario",
        "acento",
        "texto",
        "blanco",
        "alerta",
        "fondo"
      ]
    },
    "ajusteElemento": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tamanoCqw": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 20,
          "description": "Tamaño de texto en % del ancho de la pantalla"
        },
        "escala": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 3
        },
        "color": {
          "$ref": "#/$defs/rolColor"
        },
        "relleno": {
          "$ref": "#/$defs/rolColor"
        },
        "alineacion": {
          "enum": [
            "izquierda",
            "centro",
            "derecha"
          ]
        },
        "desplazamiento": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "description": "Desplazamiento en % del ancho de la pantalla (modo libre). Por dispositivo cuando aplica.",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "dispositivo": {
              "enum": [
                "todos",
                "escritorio",
                "celular"
              ]
            }
          }
        },
        "animacion": {
          "enum": [
            "auto",
            "ninguna",
            "aparecer",
            "deslizar",
            "zoom",
            "rebotar"
          ]
        },
        "retardoS": {
          "type": "number",
          "minimum": 0,
          "maximum": 600,
          "description": "Línea de tiempo: segundo en que aparece el elemento, desde el inicio de la pantalla"
        },
        "finS": {
          "type": "number",
          "minimum": 0,
          "maximum": 600,
          "description": "Línea de tiempo: segundo en que sale. Sin valor, queda hasta el final de la pantalla"
        },
        "anclaPalabra": {
          "type": "integer",
          "minimum": 0,
          "description": "Índice de la palabra de la narración con la que aparece. Si la narración cambia, el tiempo se recalcula con las marcas de la nueva voz"
        },
        "oculto": {
          "type": "boolean"
        }
      }
    },
    "elementoExtra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tipo",
        "x",
        "y",
        "ancho"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tipo": {
          "enum": [
            "titulo",
            "texto",
            "dato",
            "boton",
            "imagen",
            "insignia",
            "forma",
            "personaje"
          ]
        },
        "texto": {
          "$ref": "#/$defs/textoI18n"
        },
        "recursoId": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "ancho": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "alClic": {
          "enum": [
            "nada",
            "siguiente",
            "retroalimentacion",
            "ventana",
            "audio",
            "puntos"
          ]
        }
      }
    },
    "capsula": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titulo",
        "objetivoIds",
        "duracionEstimadaMin",
        "pantallas"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "titulo": {
          "$ref": "#/$defs/textoI18n"
        },
        "objetivoIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "duracionEstimadaMin": {
          "type": "number",
          "minimum": 0
        },
        "pantallas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pantalla"
          }
        }
      }
    },
    "modulo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titulo",
        "capsulas"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "titulo": {
          "$ref": "#/$defs/textoI18n"
        },
        "capsulas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capsula"
          }
        }
      }
    },
    "recurso": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tipo",
        "origen",
        "nombre",
        "mime"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tipo": {
          "enum": [
            "imagen",
            "svg",
            "audio",
            "video",
            "subtitulos",
            "lottie",
            "documento"
          ]
        },
        "origen": {
          "enum": [
            "biblioteca",
            "generado",
            "subido",
            "cliente"
          ]
        },
        "nombre": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "idioma": {
          "$ref": "#/$defs/idioma"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "licencia": {
          "type": "string"
        },
        "capas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ids de capas detectadas en un SVG"
        }
      }
    }
  }
}
