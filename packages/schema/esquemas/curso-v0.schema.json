{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aulaseducativas.local/esquemas/curso/v0.json",
  "title": "Curso de cápsulas (esquema v0)",
  "description": "Fuente de verdad del curso: contenido por idioma, pantallas, interacciones, narración, recursos y seguimiento. Referencia recursos por id, nunca por ruta.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versionEsquema",
    "id",
    "metadatos",
    "idiomas",
    "modoIdioma",
    "kitMarcaId",
    "objetivos",
    "modulos",
    "seguimiento",
    "recursos"
  ],
  "properties": {
    "versionEsquema": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "metadatos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titulo",
        "cliente",
        "publico",
        "duracionEstimadaMin",
        "creado",
        "actualizado"
      ],
      "properties": {
        "titulo": {
          "$ref": "#/$defs/textoI18n"
        },
        "descripcion": {
          "$ref": "#/$defs/textoI18n"
        },
        "cliente": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "nombre"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "nombre": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "publico": {
          "type": "string"
        },
        "nivel": {
          "enum": [
            "basico",
            "intermedio",
            "avanzado"
          ]
        },
        "duracionEstimadaMin": {
          "type": "number",
          "minimum": 0
        },
        "autor": {
          "type": "string"
        },
        "creado": {
          "type": "string",
          "format": "date-time"
        },
        "actualizado": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "idiomas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/idioma"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "modoIdioma": {
      "description": "unico: un idioma; separados: un paquete por idioma; mismo-paquete: todos los idiomas en un paquete con selector.",
      "enum": [
        "unico",
        "separados",
        "mismo-paquete"
      ]
    },
    "kitMarcaId": {
      "$ref": "#/$defs/id"
    },
    "objetivos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "texto",
          "nivelBloom"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "texto": {
            "$ref": "#/$defs/textoI18n"
          },
          "nivelBloom": {
            "enum": [
              "recordar",
              "comprender",
              "aplicar",
              "analizar",
              "evaluar",
              "crear"
            ]
          }
        }
      }
    },
    "modulos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/modulo"
      }
    },
    "seguimiento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterioCompletado",
        "notaMinima",
        "notaReportada"
      ],
      "properties": {
        "criterioCompletado": {
          "enum": [
            "pantallas-obligatorias",
            "sumativa"
          ]
        },
        "notaMinima": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "intentosMaximos": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "notaReportada": {
          "enum": [
            "mejor",
            "ultima"
          ]
        }
      }
    },
    "recursos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recurso"
      }
    },
    "navegacion": {
      "description": "Forma de recorrer la cápsula (patrón) y reglas de avance. Opcional: si falta, se usa patrón clásico con actividades obligatorias.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patron": {
          "enum": [
            "clasico",
            "historias",
            "vertical",
            "mapa",
            "hub",
            "ramificado",
            "inmersivo",
            "personalizado"
          ]
        },
        "patronPersonalizado": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nombre",
            "base",
            "progreso",
            "avance",
            "menu"
          ],
          "properties": {
            "nombre": {
              "type": "string",
              "maxLength": 60
            },
            "base": {
              "enum": [
                "clasico",
                "historias",
                "vertical",
                "mapa",
                "hub",
                "ramificado",
                "inmersivo"
              ]
            },
            "progreso": {
              "enum": [
                "barra",
                "segmentos",
                "puntos",
                "porcentaje",
                "ninguno"
              ]
            },
            "avance": {
              "enum": [
                "botones",
                "deslizar-y-botones",
                "desplazar"
              ]
            },
            "menu": {
              "enum": [
                "temario",
                "mapa",
                "temas",
                "ninguno"
              ]
            },
            "marcador": {
              "type": "boolean"
            },
            "barra": {
              "enum": [
                "arriba",
                "abajo",
                "flotante",
                "ninguna"
              ]
            },
            "origen": {
              "enum": [
                "usuario",
                "ia"
              ]
            }
          }
        },
        "modo": {
          "enum": [
            "libre",
            "condiciones",
            "secuencial"
          ]
        },
        "siguienteSeHabilita": {
          "enum": [
            "siempre",
            "narracion",
            "actividad"
          ]
        },
        "reanudar": {
          "enum": [
            "preguntar",
            "automatica",
            "no"
          ]
        },
        "mostrar": {
          "type": "array",
          "items": {
            "enum": [
              "temario",
              "progreso",
              "contador",
              "botones",
              "glosario",
              "recursos",
              "ayuda",
              "accesibilidad",
              "puntos",
              "idioma"
            ]
          },
          "uniqueItems": true
        },
        "objetivosAlInicio": {
          "type": "boolean"
        },
        "atajosTeclado": {
          "type": "boolean"
        }
      }
    },
    "gamificacion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nivel": {
          "enum": [
            "ninguna",
            "ligera",
            "completa"
          ]
        },
        "puntosPorAcierto": {
          "type": "integer",
          "minimum": 0
        },
        "insignias": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "nombre",
              "condicion"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "nombre": {
                "$ref": "#/$defs/textoI18n"
              },
              "recursoId": {
                "$ref": "#/$defs/id"
              },
              "condicion": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tipo",
                  "refId"
                ],
                "properties": {
                  "tipo": {
                    "enum": [
                      "completar-capsula",
                      "completar-modulo",
                      "nota-minima-interaccion"
                    ]
                  },
                  "refId": {
                    "$ref": "#/$defs/id"
                  },
                  "valor": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "idioma": {
      "enum": [
        "es",
        "en"
      ]
    },
    "textoI18n": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "origen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "revisado"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "documento",
            "ia",
            "manual"
          ]
        },
        "documentoId": {
          "$ref": "#/$defs/id"
        },
        "paginas": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "revisado": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "tipo": {
            "const": "documento"
          }
        }
      },
      "then": {
        "required": [
          "documentoId",
          "paginas"
        ]
      }
    },
    "estadoContenido": {
      "enum": [
        "borrador",
        "propuesta-ia",
        "aprobado"
      ]
    },
    "animacion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movimiento"
      ],
      "properties": {
        "movimiento": {
          "enum": [
            "aparecer",
            "deslizar",
            "rebotar",
            "flotar",
            "latir",
            "senalar",
            "parpadear"
          ]
        },
        "capa": {
          "type": "string",
          "description": "id de la capa SVG a animar; si falta, se anima la pieza completa"
        },
        "retardoMs": {
          "type": "integer",
          "minimum": 0
        },
        "duracionMs": {
          "type": "integer",
          "minimum": 0
        },
        "repetir": {
          "type": "boolean"
        }
      }
    },
    "visual": {
      "description": "Texto o imagen para opciones, cartas y elementos de interacción.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "texto": {
          "$ref": "#/$defs/textoI18n"
        },
        "recursoId": {
          "$ref": "#/$defs/id"
        },
        "alt": {
          "$ref": "#/$defs/textoI18n"
        }
      },
      "dependentRequired": {
        "recursoId": [
          "alt"
        ]
      }
    },
    "boca": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "X"
      ]
    },
    "audioNarracion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estado",
        "voz",
        "hashTexto"
      ],
      "properties": {
        "estado": {
          "enum": [
            "pendiente",
            "generado",
            "desactualizado"
          ]
        },
        "recursoAudioId": {
          "$ref": "#/$defs/id"
        },
        "voz": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proveedor",
            "voz"
          ],
          "properties": {
            "proveedor": {
              "enum": [
                "google",
                "azure",
                "elevenlabs",
                "cliente"
              ]
            },
            "voz": {
              "type": "string"
            },
            "velocidad": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            }
          }
        },
        "hashTexto": {
          "type": "string",
          "pattern": "^[a-f0-9]{8,64}$"
        },
        "duracionMs": {
          "type": "integer",
          "minimum": 0
        },
        "bocas": {
          "description": "Marcas [tiempoMs, boca] ordenadas por tiempo.",
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "$ref": "#/$defs/boca"
              }
            ],
            "items": false,
            "minItems": 2
          }
        },
        "subtitulosId": {
          "$ref": "#/$defs/id"
        }
      },
      "if": {
        "properties": {
          "estado": {
            "const": "generado"
          }
        }
      },
      "then": {
        "required": [
          "recursoAudioId",
          "duracionMs",
          "bocas",
          "subtitulosId"
        ]
      }
    },
    "narracion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texto",
        "porIdioma"
      ],
      "properties": {
        "texto": {
          "$ref": "#/$defs/textoI18n"
        },
        "personajeBloqueId": {
          "$ref": "#/$defs/id"
        },
        "porIdioma": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "es": {
              "$ref": "#/$defs/audioNarracion"
            },
            "en": {
              "$ref": "#/$defs/audioNarracion"
            }
          }
        }
      }
    },
    "preguntaQuiz": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enunciado",
        "opciones",
        "retroalimentacion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "objetivoId": {
          "$ref": "#/$defs/id"
        },
        "nivelBloom": {
          "description": "Nivel de Bloom de la pregunta para la alineación (HU-1001). Si falta, se toma el de la pantalla.",
          "enum": [
            "recordar",
            "comprender",
            "aplicar",
            "analizar",
            "evaluar",
            "crear"
          ]
        },
        "enunciado": {
          "$ref": "#/$defs/textoI18n"
        },
        "seleccionMultiple": {
          "type": "boolean"
        },
        "opciones": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "contenido",
              "correcta"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "contenido": {
                "$ref": "#/$defs/visual"
              },
              "correcta": {
                "type": "boolean"
              }
            }
          },
          "contains": {
            "properties": {
              "correcta": {
                "const": true
              }
            }
          }
        },
        "retroalimentacion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correcta",
            "incorrecta"
          ],
          "properties": {
            "correcta": {
              "$ref": "#/$defs/textoI18n"
            },
            "incorrecta": {
              "$ref": "#/$defs/textoI18n"
            }
          }
        }
      }
    },
    "interaccion": {
      "type": "object",
      "required": [
        "tipo",
        "modo",
        "datos"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "INT-01",
            "INT-02",
            "INT-03",
            "INT-04",
            "INT-05",
            "INT-06",
            "INT-07",
            "INT-08"
          ]
        },
        "modo": {
          "enum": [
            "formativa",
            "sumativa"
          ]
        },
        "peso": {
          "type": "number",
          "minimum": 0
        },
        "instruccion": {
          "$ref": "#/$defs/textoI18n"
        },
        "datos": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "INT-01"
              }
            }
          },
          "then": {
            "properties": {
              "datos": {
                "$ref": "#/$defs/datosMemoria"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "INT-02"
              }
            }
          },
          "then": {
            "properties": {
              "datos": {
                "$ref": "#/$defs/datosClasificar"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "INT-03"
              }
            }
          },
          "then": {
            "properties": {
              "datos": {
                "$ref": "#/$defs/datosOrdenar"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "INT-04"
              }
            }
          },
          "then": {
            "properties": {
              "datos": {
                "$ref": "#/$defs/datosTarjetas"
              },
              "modo": {
                "const": "formativa"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "INT-05"
              }
            }
          },
          "then": {
            "properties": {
              "datos": {
                "$ref": "#/$defs/datosQuiz"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "INT-06"
              }
            }
          },
          "then": {
            "properties": {
              "datos": {
                "$ref": "#/$defs/datosExploracion"
              },
              "modo": {
                "const": "formativa"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "INT-07"
              }
            }
          },
          "then": {
            "properties": {
              "datos": {
                "$ref": "#/$defs/datosDeslizar"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "INT-08"
              }
            }
          },
          "then": {
            "properties": {
              "datos": {
                "$ref": "#/$defs/datosDecision"
              }
            }
          }
        }
      ]
    },
    "datosMemoria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pares"
      ],
      "properties": {
        "pares": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "a",
              "b"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "a": {
                "$ref": "#/$defs/visual"
              },
              "b": {
                "$ref": "#/$defs/visual"
              }
            }
          }
        },
        "intentosMaximos": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "datosClasificar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grupos",
        "elementos"
      ],
      "properties": {
        "grupos": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "etiqueta"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "etiqueta": {
                "$ref": "#/$defs/textoI18n"
              }
            }
          }
        },
        "elementos": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "contenido",
              "grupoCorrecto"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "contenido": {
                "$ref": "#/$defs/visual"
              },
              "grupoCorrecto": {
                "$ref": "#/$defs/id"
              },
              "retroalimentacion": {
                "$ref": "#/$defs/textoI18n"
              }
            }
          }
        }
      }
    },
    "datosOrdenar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pasos"
      ],
      "properties": {
        "pasos": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "contenido"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "contenido": {
                "$ref": "#/$defs/visual"
              }
            }
          }
        }
      }
    },
    "datosTarjetas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tarjetas"
      ],
      "properties": {
        "tarjetas": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "frente",
              "reverso"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "frente": {
                "$ref": "#/$defs/visual"
              },
              "reverso": {
                "$ref": "#/$defs/visual"
              }
            }
          }
        }
      }
    },
    "datosQuiz": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preguntas"
      ],
      "properties": {
        "preguntas": {
          "type": "array",
          "minItems": 3,
          "maxItems": 15,
          "items": {
            "$ref": "#/$defs/preguntaQuiz"
          }
        },
        "segundosPorPregunta": {
          "type": "integer",
          "minimum": 5
        },
        "vidas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "preguntasPorIntento": {
          "type": "integer",
          "minimum": 1
        },
        "barajarOpciones": {
          "type": "boolean"
        }
      }
    },
    "datosExploracion": {
      "type": "object",
