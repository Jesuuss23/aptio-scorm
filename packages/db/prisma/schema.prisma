// Esquema físico de la base de datos (PostgreSQL) — Aptio SCORM
// El documento del curso vive en Curso.documento (JSONB) y valida contra
// packages/schema/esquemas/curso-v0.schema.json (v0.2).
// Las tablas guardan lo que necesita consultas, permisos, costos o historial.
//
// Multi-organización (ADR-012): las tablas raíz de cada organización llevan
// `organizacionId`; las tablas hijas (kit, versiones, etapas, narraciones…)
// heredan el aislamiento por la relación con su padre. Ver docs/12-modelo-datos.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Organizaciones (ADR-012) ----------

enum EstadoOrganizacion {
  ACTIVA
  SOLO_LECTURA // cobranza vencida (HU-1708)
  CANCELADA
}

model Organizacion {
  id            String             @id @default(uuid()) @db.Uuid
  nombre        String
  slug          String             @unique
  ruc           String? // para comprobantes SUNAT (HU-1707)
  estado        EstadoOrganizacion @default(ACTIVA)
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt

  usuarios          Usuario[]
  clientes          Cliente[]
  proyectos         Proyecto[]
  cursos            Curso[]
  generaciones      Generacion[]
  trabajosIA        TrabajoIA[]
  recursos          Recurso[]
  exportaciones     Exportacion[]
  mediciones        MedicionProceso[]
  parametrosNegocio ParametrosNegocio?
  conexionesIA      ConfigProveedor[]
  auditoria         Auditoria[]
  subidas           Subida[]
  suscripcion       Suscripcion?
  solicitudes       SolicitudSuscripcion[]
  consumosCapsulas  ConsumoCapsula[]
  comprasCapsulas   CompraCapsulas[]
  cambiosPlan       CambioPlan[]
}

// ---------- Personas y acceso ----------

enum Rol {
  SUPERADMIN // plataforma; sin organización (ADR-011, HU-1501)
  ADMINISTRADOR
  DISENADOR_INSTRUCCIONAL
  DISENADOR_GRAFICO
  PRODUCTOR
  REVISOR_CLIENTE
}

model Usuario {
  id               String    @id @default(uuid()) @db.Uuid
  organizacionId   String?   @db.Uuid
  email            String    @unique
  nombre           String
  hashClave        String? // argon2id; null si solo ingresa con Google (ADR-009)
  googleSub        String?   @unique // identificador de Google (OpenID Connect), se vincula por correo verificado
  emailVerificado  Boolean   @default(false)
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime? // 5 intentos fallidos = 15 minutos
  versionSesion    Int       @default(0) // sube al cambiar la clave o desactivar: invalida las sesiones abiertas
  rol              Rol
  clienteId        String?   @db.Uuid // solo para REVISOR_CLIENTE
  // organizacionId es null solo para SUPERADMIN
  activo           Boolean   @default(true)
  creadoEn         DateTime  @default(now())
  ultimoIngreso    DateTime?

  cliente              Cliente?      @relation(fields: [clienteId], references: [id])
  proyectos            Proyecto[]    @relation("ProyectoCreador")
  comentarios          Comentario[]
  comentariosResueltos Comentario[]  @relation("ComentarioResuelto")
  propuestasResueltas  Propuesta[]   @relation("PropuestaResuelta")
  exportaciones        Exportacion[]
  auditoria            Auditoria[]
  tokens               TokenAcceso[]
  organizacion         Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId])
}

// ---------- Clientes y kits de marca ----------

model Cliente {
  id                      String   @id @default(uuid()) @db.Uuid
  organizacionId          String   @db.Uuid
  nombre                  String
  retencionDocumentosDias Int      @default(180) // días tras la entrega para borrar documentos fuente del cliente (ADR-009)
  lmsHabitual             String?
  idiomas                 String[] @default(["es"])
  notas                   String?
  activo                  Boolean  @default(true)
  creadoEn                DateTime @default(now())

  kit           KitMarca?
  proyectos     Proyecto[]
  recursos      Recurso[]
  glosario      GlosarioTermino[]
  pronunciacion PronunciacionTermino[]
  fichasLms     FichaCompatibilidad[]
  usuarios      Usuario[]
  organizacion  Organizacion           @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId])
}

model KitMarca {
  id              String   @id @default(uuid()) @db.Uuid
  clienteId       String   @unique @db.Uuid
  estilo          String // Industrial, Corporativo, Institucional, Infantil aula, Salud…
  paleta          Json // { primario, secundario, acento, fondo, texto } en hex
  tipografias     Json // { titulos, textos } con licencia
  logoRecursoId   String?  @db.Uuid
  personaje       Json? // { recursoId, nombre, capas[], bocasDisponibles[] }
  voces           Json // { es: { proveedor, voz, velocidad }, en: {...} }
  patronPreferido String? // HU-1103 · patrón de navegación preferido del cliente (clasico, historias, mapa…)
  version         Int      @default(1)
  actualizadoEn   DateTime @updatedAt

  cliente         Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pantallasModelo PantallaModelo[]
}

model PantallaModelo {
  id                 String  @id @default(uuid()) @db.Uuid
  kitId              String  @db.Uuid
  disposicion        String // portada, idea, lista, clasificar… (enum del esquema del curso)
  nombre             String
  definicion         Json // componentes, posiciones relativas y estilos base
  miniaturaRecursoId String? @db.Uuid
  orden              Int     @default(0)
  activa             Boolean @default(true)

  kit KitMarca @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@index([kitId, disposicion])
}

model GlosarioTermino {
  id         String  @id @default(uuid()) @db.Uuid
  clienteId  String  @db.Uuid
  termino    String
  traduccion String?
  noTraducir Boolean @default(false)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, termino])
}

model PronunciacionTermino {
  id          String @id @default(uuid()) @db.Uuid
  clienteId   String @db.Uuid
  idioma      String // es | en
  escrito     String
  pronunciado String // texto o SSML

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, idioma, escrito])
}

model FichaCompatibilidad {
  id                   String   @id @default(uuid()) @db.Uuid
  clienteId            String   @db.Uuid
  lmsNombre            String
  lmsVersion           String?
  limiteSubidaMb       Int?
  notas                String?
  resultadoDiagnostico Json? // lo que devolvió el modo diagnóstico del paquete
  actualizadoEn        DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// ---------- Proyectos, material y curso ----------

enum EstadoProyecto {
  BORRADOR
  GENERANDO
  REVISION
  ENTREGADO
  ARCHIVADO
}

model Proyecto {
  id                    String         @id @default(uuid()) @db.Uuid
  organizacionId        String         @db.Uuid
  clienteId             String         @db.Uuid
  nombre                String
  estado                EstadoProyecto @default(BORRADOR)
  idiomas               String[]       @default(["es"])
  modoIdioma            String         @default("unico") // unico | separados | mismo-paquete
  publico               String?
  tono                  String?
  pantallasObjetivo     Int?
  porcentajeActividades Int?
  datosTecnicos         Json? // OPCIONAL: { lms, formato, horasCapacitacion, porcentajeScorm, fechaEntrega }
  creadoPorId           String         @db.Uuid
  creadoEn              DateTime       @default(now())
  actualizadoEn         DateTime       @updatedAt

  cliente        Cliente           @relation(fields: [clienteId], references: [id])
  creadoPor      Usuario           @relation("ProyectoCreador", fields: [creadoPorId], references: [id])
  materiales     MaterialFuente[]
  curso          Curso?
  generaciones   Generacion[]
  consumoCapsula ConsumoCapsula?
  trabajosIA     TrabajoIA[]
  mediciones     MedicionProceso[]
  recursos       Recurso[]
  organizacion   Organizacion      @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([clienteId, estado])
  @@index([organizacionId, estado])
}

enum TipoMaterial {
  PDF
  WORD
  POWERPOINT
  VIDEO
  AUDIO
  IMAGEN
  TEMA
}

model MaterialFuente {
  id            String       @id @default(uuid()) @db.Uuid
  proyectoId    String       @db.Uuid
  tipo          TipoMaterial
  recursoId     String?      @db.Uuid // null cuando tipo = TEMA
  tema          String?
  estado        String       @default("pendiente") // pendiente | procesando | listo | error
  paginas       Json? // [{ n, texto, escaneada, posibleInstruccion }]
  transcripcion Json? // [{ desde, hasta, texto }]
  mapaTemas     Json? // [{ tema, paginas, decision: conservar|complementario|omitir, motivo }]
  error         String? // motivo legible si estado = error
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @default(now()) @updatedAt

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model Curso {
  id               String   @id @default(uuid()) @db.Uuid
  organizacionId   String   @db.Uuid
  proyectoId       String   @unique @db.Uuid
  versionEsquema   String // 0.2.0
  documento        Json // documento del curso validado
  version          Int      @default(1) // bloqueo optimista
  actualizadoEn    DateTime @updatedAt
  actualizadoPorId String?  @db.Uuid

  proyecto      Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  versiones     CursoVersion[]
  propuestas    Propuesta[]
  observaciones Observacion[]
  narraciones   Narracion[]
  traducciones  Traduccion[]
  exportaciones Exportacion[]
  comentarios   Comentario[]
  organizacion  Organizacion   @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
}

model CursoVersion {
  id          String   @id @default(uuid()) @db.Uuid
  cursoId     String   @db.Uuid
  version     Int
  documento   Json
  motivo      String // "generación", "propuesta IA aplicada", "edición", "restauración"
  creadoPorId String?  @db.Uuid
  creadoEn    DateTime @default(now())

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([cursoId, version])
}

// ---------- Generación e IA ----------

enum EstadoTrabajo {
  EN_COLA
  EN_CURSO
  COMPLETADO
  ERROR
  CANCELADO
}

model Generacion {
  id             String        @id @default(uuid()) @db.Uuid
  organizacionId String        @db.Uuid
  proyectoId     String        @db.Uuid
  estado         EstadoTrabajo @default(EN_COLA)
  parametros     Json // pantallas, idiomas, público, tono, % actividades, kit
  costoUsd       Decimal       @default(0) @db.Decimal(10, 4)
  iniciadoPorId  String        @db.Uuid
  creadoEn       DateTime      @default(now())
  terminadoEn    DateTime?

  proyecto     Proyecto          @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  etapas       GeneracionEtapa[]
  trabajos     TrabajoIA[]
  organizacion Organizacion      @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
}

enum EtapaGeneracion {
  RESUMEN_MATERIAL
  OBJETIVOS_ESTRUCTURA
  STORYBOARD_GUION
  PANTALLAS
  ILUSTRACIONES
  VOZ_ES
  BOCA
  SUBTITULOS
  VERSION_EN
  CONTROL_CALIDAD
  PAQUETE
}

model GeneracionEtapa {
  id           String          @id @default(uuid()) @db.Uuid
  generacionId String          @db.Uuid
  etapa        EtapaGeneracion
  orden        Int
  estado       EstadoTrabajo   @default(EN_COLA)
  detalle      Json? // resumen para la pantalla de Producción
  inicio       DateTime?
  fin          DateTime?
  costoUsd     Decimal         @default(0) @db.Decimal(10, 4)

  generacion Generacion @relation(fields: [generacionId], references: [id], onDelete: Cascade)

  @@unique([generacionId, etapa])
}

enum TareaProveedor {
  TEXTO
  PANTALLAS
  IMAGEN
  VOZ
  BOCA
  TRADUCCION
  TRANSCRIPCION
  CALIDAD
}

model TrabajoIA {
  id             String         @id @default(uuid()) @db.Uuid
  /// HU-1513 · null = gasto de la plataforma (tareas del superadmin, p. ej. IA-19), sin organización ni proyecto.
  organizacionId String?        @db.Uuid
  proyectoId     String?        @db.Uuid
  generacionId   String?        @db.Uuid
  tarea          String // IA-01 … IA-19
  tipo           TareaProveedor
  proveedor      String
  modelo         String
  versionPrompt  String?
  tokensEntrada  Int?
  tokensSalida   Int?
  caracteres     Int?
  imagenes       Int?
  segundosAudio  Int?
  costoUsd       Decimal        @default(0) @db.Decimal(10, 4)
  estado         EstadoTrabajo  @default(EN_COLA)
  intentos       Int            @default(0)
  error          String?
  duracionMs     Int?
  /// HU-0206 · Lo que deja una tarea sin curso ni proyecto, p. ej. la propuesta de kit (IA-18) con su cliente y evidencias.
  resultado      Json?
  creadoEn       DateTime       @default(now())

  proyecto     Proyecto?     @relation(fields: [proyectoId], references: [id])
  generacion   Generacion?   @relation(fields: [generacionId], references: [id])
  propuestas   Propuesta[]
  organizacion Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([proyectoId, creadoEn])
  @@index([tipo, creadoEn])
  @@index([organizacionId, creadoEn])
}

enum EstadoPropuesta {
  PENDIENTE
  APLICADA
  DESCARTADA
  VENCIDA // el curso cambió y la propuesta ya no aplica
}

model Propuesta {
  id            String          @id @default(uuid()) @db.Uuid
  cursoId       String          @db.Uuid
  pantallaId    String? // id de pantalla dentro del documento
  tipo          String // mas-visual, menos-texto, actividad, variantes, alineacion, patron-navegacion, traduccion…
  titulo        String
  descripcion   String
  cambios       Json // JSON Patch (RFC 6902) sobre el documento del curso
  versionBase   Int // versión del curso sobre la que se calculó
  estado        EstadoPropuesta @default(PENDIENTE)
  trabajoIAId   String?         @db.Uuid
  resueltoPorId String?         @db.Uuid
  resueltoEn    DateTime?
  creadoEn      DateTime        @default(now())

  curso       Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  trabajoIA   TrabajoIA? @relation(fields: [trabajoIAId], references: [id])
  resueltoPor Usuario?   @relation("PropuestaResuelta", fields: [resueltoPorId], references: [id])

  @@index([cursoId, estado])
}

enum TipoObservacion {
  CALIDAD
  ALINEACION
  IDIOMA
  ACCESIBILIDAD
  MATERIAL_FALTANTE
}

model Observacion {
  id         String          @id @default(uuid()) @db.Uuid
  cursoId    String          @db.Uuid
  pantallaId String?
  tipo       TipoObservacion
  severidad  String // info | aviso | bloquea-entrega
  mensaje    String
  origen     String // regla | ia | usuario | tiempo
  resuelta   Boolean         @default(false)
  // HU-0505 · Categoría que muestra Revisión (ortografia, longitud, accesibilidad…), sugerencia de IA-12 y ruta del texto.
  categoria  String?
  sugerencia String?
  ruta       String?
  creadoEn   DateTime        @default(now())

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@index([cursoId, resuelta])
}

// ---------- Recursos, voz e idiomas ----------

enum TipoRecurso {
  IMAGEN
  SVG
  AUDIO
  VIDEO
  DOCUMENTO
  FUENTE
  SUBTITULO
  PAQUETE
}

enum OrigenRecurso {
  BIBLIOTECA
  GENERADO
  SUBIDO
  CLIENTE
}

model Recurso {
  id             String        @id @default(uuid()) @db.Uuid
  organizacionId String        @db.Uuid
  clienteId      String?       @db.Uuid
  proyectoId     String?       @db.Uuid
  tipo           TipoRecurso
  origen         OrigenRecurso
  claveS3        String        @unique
  mime           String
  bytes          BigInt
  ancho          Int?
  alto           Int?
  duracionMs     Int?
  hash           String // sha256 del contenido
  nombre         String
  alt            Json? // { es, en }
  licencia       String? // condición de uso del proveedor (ADR-010)
  proveedor      String? // recraft | firefly | google | ... (solo GENERADO)
  modelo         String? // modelo y versión usados (solo GENERADO)
  eliminarEn     DateTime? // borrado programado de documentos del cliente (ADR-009)
  metadatos      Json? // prompt de generación, capas SVG, etc.
  creadoEn       DateTime      @default(now())

  cliente      Cliente?     @relation(fields: [clienteId], references: [id])
  proyecto     Proyecto?    @relation(fields: [proyectoId], references: [id])
  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([clienteId, tipo])
  @@index([organizacionId, tipo])
  @@index([eliminarEn])
}

/// Subida pedida con URL firmada y aún no confirmada (HU-1404). Al confirmar se verifica el tipo real y se crea el Recurso.
model Subida {
  id             String        @id @default(uuid()) @db.Uuid
  organizacionId String        @db.Uuid
  usuarioId      String        @db.Uuid
  clienteId      String?       @db.Uuid
  proyectoId     String?       @db.Uuid
  origen         OrigenRecurso
  nombre         String
  mime           String
  bytes          BigInt
  claveS3        String        @unique
  expira         DateTime
  recursoId      String?       @db.Uuid // se llena al confirmar
  creadoEn       DateTime      @default(now())

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId, usuarioId])
}

enum EstadoNarracion {
  ACTUALIZADA
  DESACTUALIZADA
  GENERANDO
  ERROR
}

model Narracion {
  id                 String          @id @default(uuid()) @db.Uuid
  cursoId            String          @db.Uuid
  pantallaId         String
  idioma             String
  textoHash          String // sha256 del texto + diccionario + voz: si cambia, queda DESACTUALIZADA
  origen             String // tts | grabacion
  voz                String?
  velocidad          Decimal?        @db.Decimal(3, 2)
  audioRecursoId     String?         @db.Uuid
  subtituloRecursoId String?         @db.Uuid
  bocas              Json? // [[ms, "A".."X"], …]
  estado             EstadoNarracion @default(DESACTUALIZADA)
  actualizadoEn      DateTime        @updatedAt

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([cursoId, pantallaId, idioma])
}

enum EstadoTraduccion {
  PENDIENTE
  TRADUCIDA_IA
  REVISADA
  DESBORDE
}

model Traduccion {
  id              String           @id @default(uuid()) @db.Uuid
  cursoId         String           @db.Uuid
  ruta            String // JSON Pointer al texto dentro del documento
  idioma          String
  textoOrigenHash String
  estado          EstadoTraduccion @default(PENDIENTE)
  propuesta       String? // HU-0803 · versión corta de la IA para un texto en Desborde
  actualizadoEn   DateTime         @updatedAt

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([cursoId, ruta, idioma])
}

// ---------- Revisión y entrega ----------

/// HU-0506 · Comentario de una pantalla (revisor del cliente o equipo). El texto no se edita ni se borra; el equipo lo
/// resuelve o lo reabre, con quién y cuándo.
model Comentario {
  id            String    @id @default(uuid()) @db.Uuid
  cursoId       String    @db.Uuid
  pantallaId    String
  autorId       String    @db.Uuid
  texto         String
  resuelto      Boolean   @default(false)
  resueltoPorId String?   @db.Uuid
  resueltoEn    DateTime?
  creadoEn      DateTime  @default(now())

  curso       Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  autor       Usuario  @relation(fields: [autorId], references: [id])
  resueltoPor Usuario? @relation("ComentarioResuelto", fields: [resueltoPorId], references: [id])

  @@index([cursoId, pantallaId])
}

enum FormatoExportacion {
  SCORM12
  SCORM2004
  CMI5
  HTML
  JSON
  KIT_GAMIFICACION
}

model Exportacion {
  id                 String             @id @default(uuid()) @db.Uuid
  organizacionId     String             @db.Uuid
  cursoId            String             @db.Uuid
  versionCurso       Int
  formato            FormatoExportacion
  perfilLms          String             @default("generico") // generico | moodle | blackboard | chamilo | canvas
  modoIdioma         String
  estado             EstadoTrabajo      @default(EN_COLA)
  bytes              BigInt?
  informe            Json? // validaciones, advertencias, suspend_data estimado
  motivo             String? // HU-1202: por qué terminó en ERROR
  incluirDiagnostico Boolean            @default(true) // HU-1204: modo diagnóstico dentro del paquete
  recursoId          String?            @db.Uuid // ZIP en S3
  creadoPorId        String             @db.Uuid
  creadoEn           DateTime           @default(now())

  curso        Curso        @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  creadoPor    Usuario      @relation(fields: [creadoPorId], references: [id])
  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
}

// ---------- Configuración, negocio y auditoría ----------

/// HU-1304 · Una conexión por organización y tarea; las claves van en variables de entorno (RN-13-3).
model ConfigProveedor {
  id                    String         @id @default(uuid()) @db.Uuid
  organizacionId        String?        @db.Uuid
  organizacion          Organizacion?  @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  tarea                 TareaProveedor
  proveedor             String
  modelo                String
  parametros            Json? // sin claves: las claves van en variables de entorno
  costoUnitario         Json? // precios vigentes para estimar
  limiteGastoMensualUsd Decimal?       @db.Decimal(10, 2)
  activo                Boolean        @default(true)
  actualizadoEn         DateTime       @updatedAt

  @@unique([organizacionId, tarea])
}

model ParametrosNegocio {
  id             String        @id @default(uuid())
  /// HU-1303 · Un registro por organización; el antiguo «unico» queda sin organización y no se usa.
  organizacionId String?       @unique @db.Uuid
  datos          Json // precio actual, precio competencia, tarifa hora, personas, horas productivas, licencias, tipo de cambio…
  actualizadoEn  DateTime      @updatedAt
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
}

model MedicionProceso {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  proyectoRef    String // nombre del proyecto medido (puede ser anterior a la herramienta)
  /// HU-1303 · Proyecto de la herramienta, si el medido existe en ella.
  proyectoId     String?      @db.Uuid
  escenario      String // hoy | generador
  etapa          String
  horas          Decimal      @db.Decimal(6, 2)
  notas          String?
  registradoPor  String?
  creadoEn       DateTime     @default(now())
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  proyecto       Proyecto?    @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  @@index([proyectoRef, escenario])
  @@index([organizacionId])
}

model Auditoria {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String?  @db.Uuid
  usuarioId      String?  @db.Uuid
  accion         String
  entidad        String
  entidadId      String?
  datos          Json?
  creadoEn       DateTime @default(now())

  usuario      Usuario?      @relation(fields: [usuarioId], references: [id])
  organizacion Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([entidad, entidadId])
}

// Invitaciones y cambios de clave (ADR-009). Se guarda solo el hash del token.
model TokenAcceso {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @db.Uuid
  tipo      String // INVITACION | RESTABLECER_CLAVE
  hashToken String    @unique
  expira    DateTime
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
}

/// HU-1403 · Estado de una copia de seguridad diaria (o pedida con «Respaldar ahora»).
enum EstadoRespaldo {
  EN_CURSO
  EXITOSO
  FALLIDO
  /// Pasó la retención de 14 días: sus objetos se borraron del bucket de respaldos.
  EXPIRADO
}

/// HU-1403 · Una copia de seguridad de la plataforma: volcado de PostgreSQL y copia de los objetos de S3 (CP-108).
model Respaldo {
  id              String         @id @default(uuid()) @db.Uuid
  /// Inicio de la copia; da nombre a su carpeta en el bucket de respaldos.
  fecha           DateTime       @default(now())
  estado          EstadoRespaldo @default(EN_CURSO)
  /// programado (03:00 de Lima) o manual («Respaldar ahora»).
  origen          String         @default("programado")
  solicitadoPorId String?        @db.Uuid
  /// Bucket de respaldos y carpeta de esta copia (volcado, objetos y manifiesto).
  bucket          String?
  ubicacion       String?
  claveVolcado    String?
  objetos         Int?
  tamanoBytes     BigInt?
  duracionMs      Int?
  error           String?
  expiradoEn      DateTime?

  @@index([fecha])
}

/// HU-1502 · Estado de una página del sitio comercial (RN-16-6): un borrador o una programada responden 404 y no
/// entran al sitemap; una programada pasa sola a publicada al llegar `publicarEn`.
enum EstadoPagina {
  BORRADOR
  PROGRAMADA
  PUBLICADA
}

/// HU-1502 · Página del sitio comercial (M16, ADR-011). De la plataforma, sin organización; solo la administra el
/// superadmin. Bloques (HU-1503) y landings de sector (HU-1514); el SEO completo llega con la HU-1512.
model SitioPagina {
  id                   String        @id @default(uuid()) @db.Uuid
  /// `/` (inicio) o `/segmento[/segmento…]` con minúsculas, números y guiones.
  ruta                 String
  idioma               String        @default("es")
  titulo               String
  estado               EstadoPagina  @default(BORRADOR)
  /// Fecha y hora en que se publica sola (solo en PROGRAMADA).
  publicarEn           DateTime?
  /// Última vez que pasó a PUBLICADA.
  publicadaEn          DateTime?
  /// HU-1514 · `general` o `sector` (landing por sector, `@aptio/schema/sitio-sectores`).
  tipo                 String        @default("general")
  /// Nombre del sector de una landing (los testimonios se emparejan por él, CP-157).
  sector               String?
  /// Título y texto de la portada de una landing.
  portada              Json?
  /// Meta título (hasta 60, texto plano); si falta, se usa el título (HU-1512).
  metaTitulo           String?
  /// HU-1512 · Meta descripción (hasta 160, texto plano).
  metaDescripcion      String?
  /// HU-1512 · URL canónica propia: ruta interna `/…` o `https://…`; null = la del dominio.
  canonical            String?
  /// HU-1512 · false = `noindex`, fuera del sitemap y sin alternas hreflang (CP-125).
  indexar              Boolean       @default(true)
  /// HU-1512 · Tipo de datos estructurados JSON-LD: WebPage, FAQPage o Product.
  datosEstructurados   String        @default("WebPage")
  /// Categoría con que empieza filtrada la sección Blog de la landing (HU-1511, CP-159).
  blogCategoriaInicial String?
  creadoEn             DateTime      @default(now())
  actualizadoEn        DateTime      @updatedAt
  bloques              SitioBloque[]

  @@unique([ruta, idioma])
  @@index([estado, publicarEn])
}

/// Bloque de una página del sitio comercial (HU-1503, REQ-066). El tipo sale
/// del catálogo cerrado `TIPOS_BLOQUE` de `@aptio/schema`; nace oculto (RN-16-2).
model SitioBloque {
  id            String      @id @default(uuid()) @db.Uuid
  paginaId      String      @db.Uuid
  pagina        SitioPagina @relation(fields: [paginaId], references: [id], onDelete: Cascade)
  tipo          String
  /// Posición 0, 1, 2… sin huecos dentro de la página.
  orden         Int
  visible       Boolean     @default(false)
  /// Datos propios del bloque; ocultarlo no los borra (CP-112).
  ajustes       Json?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  @@index([paginaId, orden])
}

/// Elemento de contenido del sitio comercial (HU-1504, REQ-066, PNT-27): cifras, testimonios, logos, funcionalidades,
/// pasos, LMS y preguntas. Los campos de `datos` los fija `@aptio/schema/sitio-contenido`; nace oculto (RN-16-2).
model SitioElemento {
  id            String   @id @default(uuid()) @db.Uuid
  coleccion     String
  /// Posición 0, 1, 2… sin huecos dentro de la colección.
  orden         Int
  visible       Boolean  @default(false)
  /// HU-1505 · Dato inventado: bloquea publicar en producción mientras esté visible (RN-16-3).
  ficticio      Boolean  @default(false)
  datos         Json
  /// HU-1510 · es | en: cada idioma tiene sus elementos y su propio orden.
  idioma        String   @default("es")
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([coleccion, idioma, orden])
}

/// HU-1506 · Enlaces del menú principal y del pie (REQ-066, PNT-25). El menú es plano; el pie tiene
/// columnas (sin padre) con sus enlaces (con padre). Ocultar no borra; borrar una columna borra sus enlaces.
model SitioEnlace {
  id            String        @id @default(uuid()) @db.Uuid
  /// menu | pie
  zona          String
  padreId       String?       @db.Uuid
  padre         SitioEnlace?  @relation("SitioEnlaceHijos", fields: [padreId], references: [id], onDelete: Cascade)
  hijos         SitioEnlace[] @relation("SitioEnlaceHijos")
  texto         String
  /// Ruta interna (/precios, /#testimonios) o https://. Vacía solo en una columna del pie.
  ruta          String?
  /// Posición 0, 1, 2… sin huecos entre hermanos (misma zona y mismo padre).
  orden         Int
  visible       Boolean       @default(false)
  /// HU-1510 · es | en: cada idioma tiene su menú y su pie, con su propio orden.
  idioma        String        @default("es")
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  @@index([zona, idioma, padreId, orden])
}

/// HU-1507 · Versión publicada del sitio (REQ-068, RN-16-5): instantánea inmutable del sitio completo. El sitio público
/// sirve solo la última. No se edita ni se borra; restaurar la N crea una nueva con la instantánea de N (CP-119).
model SitioVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  /// 1, 2, 3… sin repetir; la mayor es la que ve el sitio.
  numero             Int       @unique
  /// Páginas publicadas con sus bloques y elementos visibles, y la navegación visible (`@aptio/schema/sitio-versiones`).
  instantanea        Json
  /// Quién publicó; null cuando la publica la plataforma (programada). Sin llave foránea: la versión no cambia aunque se borre el usuario.
  publicadoPorId     String?   @db.Uuid
  publicadoPorNombre String?
  /// produccion | pruebas
  entorno            String
  /// publicacion | pagina | programada | restauracion
  origen             String
  /// Con origen restauracion: el número de la versión restaurada.
  restauradaDe       Int?
  /// HU-1508 · Pre-render del HTML al bucket: en_curso | listo | error.
  prerenderEstado    String    @default("en_curso")
  prerenderEn        DateTime?
  prerenderError     String?
  creadoEn           DateTime  @default(now())
}

/// HU-1509 · Ajustes del sitio comercial (REQ-073, PNT-38): una sola fila (`id` = "sitio") con dominio, marca, analítica,
/// WhatsApp, correo de leads y modo mantenimiento, validados con `@aptio/schema/sitio-ajustes`.
model SitioAjustes {
  id               String   @id @default("sitio")
  datos            Json
  actualizadoPorId String?  @db.Uuid
  actualizadoEn    DateTime @updatedAt
}

/// HU-1512 · Redirección 301 del sitio público (CP-124): de una ruta interna a otra, sin cadenas ni bucles.
model SitioRedireccion {
  id            String   @id @default(uuid()) @db.Uuid
  desde         String   @unique
  hacia         String
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

/// HU-1512 · Ajustes SEO del sitio: una sola fila (`id` = "seo").
model SitioSeo {
  id                     String   @id @default("seo")
  /// Reglas extra de robots.txt (solo `Allow:`, `Disallow:` y comentarios).
  robotsExtra            String   @default("")
  /// HU-1513 · Contenido de `/llms.txt` (texto plano, hasta 20 000 caracteres); vacío = el sitio responde 404.
  llmsTxt                String   @default("")
  /// HU-1513 · Rastreadores de IA bloqueados en robots.txt (del catálogo de `@aptio/schema/sitio-seo-ia`); vacío = todos permitidos.
  rastreadoresBloqueados String[] @default([])
  actualizadoPorId       String?  @db.Uuid
  actualizadoEn          DateTime @updatedAt
}

/// HU-1513 · Pregunta objetivo del SEO para IA (REQ-072, PNT-30): lo que la gente le pregunta a un asistente. El
/// superadmin marca a mano si cada asistente menciona la marca al responder.
model SitioPreguntaIa {
  id            String   @id @default(uuid()) @db.Uuid
  pregunta      String
  /// { chatgpt | claude | gemini | perplexity: { estado: sin_revisar | si | no, revisadoEn: ISO | null } }
  menciones     Json     @default("{}")
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

/// HU-1513 · Propuesta de contenido de la IA (IA-19, CP-127). Nada se publica solo: «Crear borrador» crea una página en
/// borrador o una pregunta frecuente oculta, y la propuesta guarda cuál.
model SitioPropuestaIa {
  id            String   @id @default(uuid()) @db.Uuid
  /// pagina | pregunta
  tipo          String
  /// pagina: { titulo, ruta, metaTitulo, metaDescripcion, motivo }; pregunta: { pregunta, respuesta, pagina?, motivo }
  datos         Json
  /// pendiente | borrador_creado | descartada
  estado        String   @default("pendiente")
  /// La página o el elemento que creó «Crear borrador».
  creadoId      String?  @db.Uuid
  trabajoId     String?  @db.Uuid
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([estado, creadoEn])
}

/// HU-1511 · Conexión del sitio con el WordPress del blog (REQ-070, PNT-28, RN-16-8): una sola fila (`id` = "blog").
/// El sitio no edita artículos: guarda una copia de lectura que sincroniza el worker.
model SitioBlog {
  id             String    @id @default("blog")
  /// https://… del WordPress; null = sin conectar.
  url            String?
  /// Cada cuántos minutos se sincroniza: 15, 30 o 60.
  frecuenciaMin  Int       @default(15)
  /// Cuántos artículos muestra la sección Blog por filtro.
  porPagina      Int       @default(6)
  mostrarImagen  Boolean   @default(true)
  mostrarAutor   Boolean   @default(true)
  /// La última sincronización que terminó bien.
  sincronizadoEn DateTime?
  /// El último intento, bien o mal.
  intentoEn      DateTime?
  /// El error del último intento (CP-156); null si terminó bien.
  error          String?
  actualizadoEn  DateTime  @updatedAt
}

/// HU-1511 · Copia de una categoría de WordPress con su orden y visibilidad en la sección Blog (CP-155).
model WpCategoria {
  /// id de WordPress
  id             Int      @id
  nombre         String
  slug           String
  orden          Int
  visible        Boolean  @default(true)
  sincronizadoEn DateTime

  @@index([orden])
}

/// HU-1511 · Copia de lectura de un artículo publicado en WordPress (CP-154): solo `publish` y sin clave.
model WpArticulo {
  /// id de WordPress
  id             Int      @id
  slug           String
  titulo         String
  extracto       String
  /// ids de WpCategoria; un artículo sale en cada una de sus categorías visibles.
  categorias     Int[]
  autor          String?
  fecha          DateTime
  /// Imagen destacada copiada a `sitio/blog/{archivo}`, con su origen para no bajarla de nuevo.
  imagen         String?
  imagenOrigen   String?
  imagenAncho    Int?
  imagenAlto     Int?
  enlace         String
  visible        Boolean  @default(true)
  sincronizadoEn DateTime

  @@index([fecha])
}

/// HU-1601 · Lead del sitio comercial (REQ-074, PNT-34, RN-17-1): uno por correo. La atribución es la del primer
/// contacto (origen, vía, página de entrada y UTM) y no cambia; cada envío posterior suma al historial. Los campos del
/// CRM llegan con la HU-1602. Reglas en `@aptio/schema/leads`.
model Lead {
  id                 String       @id @default(uuid()) @db.Uuid
  /// En minúsculas y sin espacios.
  correo             String       @unique
  nombre             String       @default("")
  empresa            String?
  mensaje            String?
  /// formulario | popup | chatbot | agendador | suscripcion | boletin | asistente_ia
  origen             String
  /// El canal que capturó el lead; difiere de `origen` cuando el referente es un asistente de IA.
  via                String
  paginaEntrada      String
  paginaFormulario   String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  referente          String?
  idioma             String       @default("es")
  /// NUEVO | CONTACTADO | DEMO | PROPUESTA | GANADO | PERDIDO
  etapa              String       @default("NUEVO")
  consentimiento     Boolean      @default(false)
  consentimientoEn   DateTime?
  totalContactos     Int          @default(1)
  /// [{ en, via, pagina, mensaje? }] con cada envío recibido, del más antiguo al más nuevo (hasta 50).
  historialContactos Json         @default("[]")
  creadoEn           DateTime     @default(now())
  actualizadoEn      DateTime     @updatedAt
  envios             LeadEnvio[]
  citas              AgendaCita[]

  @@index([origen, creadoEn])
  @@index([etapa, creadoEn])
  @@index([creadoEn])
}

/// HU-1602 · Una conexión con un CRM o el webhook firmado (REQ-075, RN-17-2). Una fila por tipo. Las claves de HubSpot,
/// Pipedrive y Zoho viven en variables de entorno; el secreto del webhook se genera en el panel.
model CrmConexion {
  id            String      @id @default(uuid()) @db.Uuid
  /// hubspot | pipedrive | zoho | webhook
  tipo          String      @unique
  activa        Boolean     @default(false)
  /// { campoDelSitio: "propiedad del CRM" }; los campos sin propiedad no se envían.
  mapeo         Json        @default("{}")
  /// Solo el webhook: https, sin red interna.
  url           String?
  /// Solo el webhook: la clave HMAC-SHA256.
  secreto       String?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
  envios        LeadEnvio[]
}

/// HU-1602 · El envío de un lead a una conexión: su estado, intentos y el motivo del último error (CP-129).
model LeadEnvio {
  id            String      @id @default(uuid()) @db.Uuid
  leadId        String      @db.Uuid
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conexionId    String      @db.Uuid
  conexion      CrmConexion @relation(fields: [conexionId], references: [id], onDelete: Cascade)
  /// pendiente | enviado | error
  estado        String      @default("pendiente")
  intentos      Int         @default(0)
  motivo        String?
  idExterno     String?
  enviadoEn     DateTime?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  @@unique([leadId, conexionId])
  @@index([estado])
}

/// HU-1603 · Un popup del sitio (REQ-076, PNT-31, RN-17-3): modal, deslizable o barra, con su disparador, sus páginas,
/// su frecuencia y su resultado. Se sirve en vivo (`GET /s/_popups.json`): apagarlo vale sin republicar (CP-132).
/// Reglas en `@aptio/schema/popups`.
model SitioPopup {
  id              String   @id @default(uuid()) @db.Uuid
  nombre          String
  /// modal | deslizable | barra
  tipo            String
  /// es | en
  idioma          String   @default("es")
  /// al_cargar | tiempo | desplazamiento | intencion_salida | clic_elemento
  disparador      String
  /// Segundos (tiempo) o porcentaje (desplazamiento); null en los demás.
  valorDisparador Int?
  /// Rutas exactas o con comodín final (`/blog/*`); `*` sola es todo el sitio.
  paginas         Json     @default("[\"*\"]")
  titulo          String
  texto           String   @default("")
  boton           String
  /// pedir_correo | enlace_interno
  accion          String
  /// Solo en enlace_interno: ruta del sitio que empieza con `/`.
  enlaceDestino   String?
  /// Mínimo 7 (RN-17-3).
  frecuenciaDias  Int      @default(7)
  visible         Boolean  @default(false)
  orden           Int      @default(0)
  /// Dato inventado: nunca se sirve en producción.
  ficticio        Boolean  @default(false)
  impresiones     Int      @default(0)
  conversiones    Int      @default(0)
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  @@index([visible, idioma, orden])
}

/// HU-1605 · Un tipo de reunión que ofrece el agendador (REQ-078, PNT-33, RN-17-5): duración y asesores que lo atienden.
/// Reglas en `@aptio/schema/agenda`.
model AgendaTipo {
  id            String         @id @default(uuid()) @db.Uuid
  nombreEs      String
  nombreEn      String         @default("")
  /// De 15 a 120.
  minutos       Int            @default(30)
  asesores      AgendaAsesor[]
  /// Un tipo nuevo se crea oculto (RN-16-2).
  visible       Boolean        @default(false)
  orden         Int            @default(0)
  /// Dato inventado: nunca se ofrece en producción.
  ficticio      Boolean        @default(false)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
  citas         AgendaCita[]

  @@index([visible, orden])
}

/// HU-1605 · Un asesor que atiende demos: su correo recibe la copia de cada invitación y su enlace fijo de videollamada
/// (https) va en la invitación. Su calendario es el de Aptio (sus citas confirmadas): Google Calendar y Outlook llegan
/// con su propia historia (SUP-251).
model AgendaAsesor {
  id                 String       @id @default(uuid()) @db.Uuid
  nombre             String
  correo             String
  enlaceVideollamada String
  visible            Boolean      @default(true)
  ficticio           Boolean      @default(false)
  creadoEn           DateTime     @default(now())
  actualizadoEn      DateTime     @updatedAt
  tipos              AgendaTipo[]
  citas              AgendaCita[]
}

/// HU-1605 · Ajustes del agendador: una sola fila (`id` = "agenda"). Las franjas son horas de inicio de lunes a viernes
/// en hora de Lima (UTC−5); los días bloqueados son fechas `AAAA-MM-DD` de Lima.
model AgendaAjustes {
  id                  String   @id @default("agenda")
  franjas             String[] @default(["09:00", "10:00", "11:30", "15:00", "16:30"])
  anticipacionHoras   Int      @default(4)
  horizonteDias       Int      @default(30)
  diasBloqueados      String[] @default([])
  recordatoriosCorreo Boolean  @default(true)
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @updatedAt
}

/// HU-1605 · Una cita del agendador (CP-135, CP-136). `inicio` y `fin` en UTC. Un índice único parcial (en la
/// migración: Prisma no los declara) impide dos citas confirmadas del mismo asesor a la misma hora. El enlace de
/// cancelación lleva un token cuyo SHA-256 se guarda aquí; el token no se guarda.
model AgendaCita {
  id                       String       @id @default(uuid()) @db.Uuid
  tipoId                   String       @db.Uuid
  tipo                     AgendaTipo   @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  asesorId                 String       @db.Uuid
  asesor                   AgendaAsesor @relation(fields: [asesorId], references: [id], onDelete: Restrict)
  inicio                   DateTime
  fin                      DateTime
  nombre                   String
  /// En minúsculas y sin espacios.
  correo                   String
  empresa                  String?
  lms                      String?
  /// es | en: el idioma de la invitación y los recordatorios.
  idioma                   String       @default("es")
  /// confirmada | cancelada | realizada | no_asistio
  estado                   String       @default("confirmada")
  leadId                   String?      @db.Uuid
  lead                     Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  tokenCancelacionHash     String       @unique
  canceladaPor             String?
  invitacionEnviadaEn      DateTime?
  recordatorio24hEnviadoEn DateTime?
  recordatorio1hEnviadoEn  DateTime?
  cancelacionEnviadaEn     DateTime?
  creadoEn                 DateTime     @default(now())
  actualizadoEn            DateTime     @updatedAt

  @@index([asesorId, inicio])
  @@index([estado, inicio])
  @@index([inicio])
}

/// HU-1604 · Ajustes del chatbot del sitio (REQ-077, PNT-32, RN-17-4): una sola fila (`id` = "chatbot"). El horario de
/// atención humana va en hora de Lima (UTC−5) y los días son 1 (lunes) a 7 (domingo). Reglas en `@aptio/schema/chatbot`.
model SitioChatbot {
  id            String   @id @default("chatbot")
  nombre        String   @default("Ana")
  saludoEs      String   @default("")
  saludoEn      String   @default("")
  /// cercano | formal | directo
  tono          String   @default("cercano")
  /// agendar_demo | captar_lead | derivar_whatsapp
  objetivo      String   @default("agendar_demo")
  horarioInicio String   @default("09:00")
  horarioFin    String   @default("18:00")
  diasAtencion  Int[]    @default([1, 2, 3, 4, 5])
  /// Se sirve en vivo (`GET /s/_chatbot.json`): apagarlo vale sin republicar.
  visible       Boolean  @default(false)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

/// HU-1604 · Una respuesta rápida del chatbot. «agendar_demo» y «hablar_persona» se resuelven en el navegador sin IA.
model SitioChatRapida {
  id            String   @id @default(uuid()) @db.Uuid
  textoEs       String
  textoEn       String   @default("")
  /// consulta_ia | agendar_demo | hablar_persona
  accion        String
  visible       Boolean  @default(true)
  orden         Int      @default(0)
  /// Dato inventado: nunca se sirve en producción.
  ficticio      Boolean  @default(false)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([visible, orden])
}

/// HU-1604 · Una fuente manual de la base de conocimiento del chatbot, además de las páginas y preguntas frecuentes de
/// la versión publicada.
model SitioChatFuente {
  id            String   @id @default(uuid()) @db.Uuid
  titulo        String
  contenido     String
  /// es | en
  idioma        String   @default("es")
  visible       Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([visible, idioma])
}

/// HU-1604 · Una conversación del chatbot (CP-133, CP-134). Sin IP ni datos personales: los datos del visitante van al
/// lead o a la cita, no aquí. Se borra a los 90 días (`expiraEn`).
model SitioConversacion {
  id            String   @id @default(uuid()) @db.Uuid
  /// es | en
  idioma        String   @default("es")
  /// [{ de: "visitante" | "bot", texto, en, fuentes?, accion? }]
  mensajes      Json     @default("[]")
  /// respuesta | lead | demo | persona | sin_conversion
  resultado     String   @default("sin_conversion")
  expiraEn      DateTime
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([creadoEn])
  @@index([expiraEn])
}

/// HU-1607 · Visitas del sitio por día, ruta e idioma (REQ-080, PNT-24), sumadas por `POST /s/_visita`. Anónimas: sin
/// IP, cookies ni identificadores. `dia` es la fecha en hora de Lima (UTC−5). `visitas` son las sesiones que empezaron
/// en esa ruta y `paginasVistas`, todas las vistas de la página.
model SitioVisitaDia {
  id            String   @id @default(uuid()) @db.Uuid
  dia           DateTime @db.Date
  ruta          String
  /// es | en
  idioma        String   @default("es")
  visitas       Int      @default(0)
  paginasVistas Int      @default(0)

  @@unique([dia, ruta, idioma])
  @@index([dia])
}

// ---------- Planes (HU-1702, M18, REQ-082, PNT-35) ----------

/// HU-1702 · Plan de suscripción que alimenta /precios y el pago. Precios en soles enteros, sin IGV. `precioMes` null =
/// plan a medida (el botón lleva a agendar). Nace oculto; un ficticio visible bloquea publicar en producción (RN-16-3).
/// No se borra (las suscripciones lo van a referir): se oculta.
model Plan {
  id               String   @id @default(uuid()) @db.Uuid
  /// Estable para la URL (`/publico/planes/{slug}`, `/agendar-demo?plan={slug}`).
  slug             String   @unique
  nombre           String
  descripcion      String   @default("")
  precioMes        Int?
  /// Precio anual propio; null = precioMes × 12 × (1 − descuentoAnual / 100).
  precioAnual      Int?
  /// HU-1704 · Dólares enteros sin IGV, opcionales (RN-18-9). Sin precio en USD, el plan se cobra solo en soles.
  precioMesUsd     Int?
  /// Precio anual propio en USD; null = precioMesUsd × 12 × (1 − descuentoAnual / 100).
  precioAnualUsd   Int?
  capsulasMes      Int?
  usuarios         Int?
  capsulaAdicional Int?
  textoBoton       String   @default("Suscribirme")
  destacado        Boolean  @default(false)
  visible          Boolean  @default(false)
  orden            Int      @default(0)
  /// [{ texto, visible }]
  caracteristicas  Json     @default("[]")
  ficticio         Boolean  @default(false)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  suscripciones  Suscripcion[]          @relation("PlanSuscripcion")
  solicitudes    SolicitudSuscripcion[]
  /// HU-1706 · Bajadas programadas y subidas de plan.
  programadas    Suscripcion[]          @relation("PlanProgramado")
  cambiosOrigen  CambioPlan[]           @relation("CambioPlanOrigen")
  cambiosDestino CambioPlan[]           @relation("CambioPlanDestino")

  @@index([orden])
}

/// HU-1702 · Ajustes de la página de precios (fila única `planes`).
model PlanesAjustes {
  id             String   @id @default("planes")
  mostrarAnual   Boolean  @default(true)
  descuentoAnual Int      @default(20)
  conIgv         Boolean  @default(false)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt
}

// ---------- HU-1703 · Alta de suscripción (REQ-083, CP-143, RN-18-2, RN-18-3) ----------

enum CicloSuscripcion {
  MENSUAL
  ANUAL
}

enum EstadoSuscripcion {
  ACTIVA
  /// HU-1706 · Cancelada al fin del período pagado (RN-18-7): sin cuota para cápsulas nuevas.
  CANCELADA
}

enum TipoComprobante {
  FACTURA // con RUC
  BOLETA // sin RUC
}

enum EstadoSolicitudSuscripcion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

/// La suscripción de una organización: una por organización. El precio pactado no cambia si cambia el plan (RN-18-2, SUP-285).
model Suscripcion {
  id                  String                @id @default(uuid()) @db.Uuid
  organizacionId      String                @unique @db.Uuid
  organizacion        Organizacion          @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  planId              String                @db.Uuid
  plan                Plan                  @relation("PlanSuscripcion", fields: [planId], references: [id])
  ciclo               CicloSuscripcion
  /// Soles enteros sin IGV por ciclo (el mes o el año).
  precioPactadoSinIgv Int
  moneda              String                @default("PEN")
  estado              EstadoSuscripcion     @default(ACTIVA)
  inicioPeriodo       DateTime
  finPeriodo          DateTime
  /// prueba (HU-1703); las reales llegan con la HU-1704.
  pasarela            String
  ultimos4Digitos     String?
  solicitudId         String?               @unique @db.Uuid
  solicitud           SolicitudSuscripcion? @relation(fields: [solicitudId], references: [id])
  cobros              Cobro[]
  consumosCapsulas    ConsumoCapsula[]
  comprasCapsulas     CompraCapsulas[]
  /// HU-1706 · Cancelación al fin del período pagado (RN-18-7): marcada por el administrador, se puede reanudar antes.
  cancelarAlFin       Boolean               @default(false)
  /// Cuándo pasó a CANCELADA (el fin del período).
  canceladaEn         DateTime?
  /// HU-1706 · Bajada de plan programada: rige al renovar, sin cobro ni devolución.
  planProgramadoId    String?               @db.Uuid
  planProgramado      Plan?                 @relation("PlanProgramado", fields: [planProgramadoId], references: [id], onDelete: Restrict)
  cambiosPlan         CambioPlan[]
  creadoEn            DateTime              @default(now())
  actualizadoEn       DateTime              @updatedAt
}

/// El checkout pendiente desde /pago: datos de la empresa, montos y el evento de la pasarela que lo resolvió (idempotencia).
model SolicitudSuscripcion {
  id              String                     @id @default(uuid()) @db.Uuid
  planId          String                     @db.Uuid
  plan            Plan                       @relation(fields: [planId], references: [id])
  ciclo           CicloSuscripcion
  razonSocial     String
  ruc             String?
  tipoComprobante TipoComprobante
  nombreAdmin     String
  /// En minúsculas.
  correoAdmin     String
  subtotal        Decimal                    @db.Decimal(10, 2)
  igv             Decimal                    @db.Decimal(10, 2)
  total           Decimal                    @db.Decimal(10, 2)
  moneda          String                     @default("PEN")
  estado          EstadoSolicitudSuscripcion @default(PENDIENTE)
  pasarela        String
  /// El id del evento de la pasarela que la aprobó o rechazó: un evento se procesa una sola vez (RN-18-3).
  eventoPagoId    String?                    @unique
  motivoRechazo   String?
  /// Página de entrada, UTM, referente e idioma del visitante, para el lead.
  atribucion      Json                       @default("{}")
  organizacionId  String?                    @unique @db.Uuid
  organizacion    Organizacion?              @relation(fields: [organizacionId], references: [id], onDelete: SetNull)
  suscripcion     Suscripcion?
  cobros          Cobro[]
  resueltaEn      DateTime?
  creadoEn        DateTime                   @default(now())
  actualizadoEn   DateTime                   @updatedAt

  @@index([correoAdmin])
}

// ---------- HU-1704 · Pasarelas de pago y webhooks (REQ-084, REQ-110, CP-144, CP-145, RN-18-3, RN-18-9) ----------

enum EstadoCobro {
  APROBADO
  REEMBOLSADO
}

enum ModoPasarela {
  pruebas
  produccion
}

/// Un cobro por cada evento de pago aprobado (idempotencia por `eventoPagoId`). Nunca guarda el número ni otro dato
/// sensible de la tarjeta: solo la referencia de la pasarela y los 4 últimos dígitos (REQ-110). Sin suscripción = pago
/// aprobado sin alta (SUP-291), que el superadmin puede reembolsar.
model Cobro {
  id                     String                @id @default(uuid()) @db.Uuid
  /// El alta que pagó este cobro; null si el cobro es de cápsulas adicionales (HU-1705).
  solicitudSuscripcionId String?               @db.Uuid
  solicitud              SolicitudSuscripcion? @relation(fields: [solicitudSuscripcionId], references: [id], onDelete: Restrict)
  /// HU-1705 · La compra de cápsulas adicionales que pagó este cobro.
  compraCapsulasId       String?               @db.Uuid
  compraCapsulas         CompraCapsulas?       @relation(fields: [compraCapsulasId], references: [id], onDelete: Restrict)
  /// HU-1706 · La subida de plan que pagó este cobro (la diferencia prorrateada).
  cambioPlanId           String?               @db.Uuid
  cambioPlan             CambioPlan?           @relation(fields: [cambioPlanId], references: [id], onDelete: Restrict)
  suscripcionId          String?               @db.Uuid
  suscripcion            Suscripcion?          @relation(fields: [suscripcionId], references: [id], onDelete: SetNull)
  /// El id del evento de la pasarela: un evento produce un solo cobro (RN-18-3, CP-144).
  eventoPagoId           String                @unique
  /// Con IGV, en la moneda del cobro.
  monto                  Decimal               @db.Decimal(10, 2)
  moneda                 String
  pasarela               String
  /// Referencia de la transacción en la pasarela (Stripe: payment intent; Culqi: cargo), para reembolsar.
  tokenPago              String?
  ultimos4Digitos        String?
  estado                 EstadoCobro           @default(APROBADO)
  reembolsoId            String?
  reembolsadoEn          DateTime?
  creadoEn               DateTime              @default(now())
  actualizadoEn          DateTime              @updatedAt

  @@index([solicitudSuscripcionId])
  @@index([suscripcionId])
  @@index([compraCapsulasId])
  @@index([cambioPlanId])
}

enum OrigenConsumo {
  CUOTA
  ADICIONAL
}

enum EstadoCompraCapsulas {
  PENDIENTE
  APROBADA
  RECHAZADA
}

/// HU-1705 · Una cápsula consumida: un proyecto cuenta una sola vez, al lanzar su primera generación (RN-18-6). Volver a
/// generar, continuar, regenerar la voz o editar no consume. Sin suscripción (organización interna) se registra sin límite.
model ConsumoCapsula {
  id             String        @id @default(uuid()) @db.Uuid
  organizacionId String        @db.Uuid
  organizacion   Organizacion  @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  suscripcionId  String?       @db.Uuid
  suscripcion    Suscripcion?  @relation(fields: [suscripcionId], references: [id], onDelete: SetNull)
  proyectoId     String        @unique @db.Uuid
  proyecto       Proyecto      @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  /// La ventana mensual en que se consumió, anclada en el inicio del período de la suscripción.
  ventanaInicio  DateTime
  ventanaFin     DateTime
  origen         OrigenConsumo @default(CUOTA)
  creadoEn       DateTime      @default(now())

  @@index([organizacionId, ventanaInicio])
}

/// HU-1705 · La compra de cápsulas adicionales: valen solo en la ventana mensual en que se pagan (no se acumulan).
model CompraCapsulas {
  id               String               @id @default(uuid()) @db.Uuid
  organizacionId   String               @db.Uuid
  organizacion     Organizacion         @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  suscripcionId    String               @db.Uuid
  suscripcion      Suscripcion          @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  cantidad         Int
  /// En la moneda de la suscripción, con dos decimales.
  montoSinIgv      Decimal              @db.Decimal(10, 2)
  igv              Decimal              @db.Decimal(10, 2)
  montoTotalConIgv Decimal              @db.Decimal(10, 2)
  moneda           String
  pasarela         String
  estado           EstadoCompraCapsulas @default(PENDIENTE)
  /// El evento de la pasarela que la resolvió (idempotencia, RN-18-3).
  eventoPagoId     String?              @unique
  motivoRechazo    String?
  /// La ventana mensual en que se acreditan, fijada al aprobarse.
  ventanaInicio    DateTime?
  ventanaFin       DateTime?
  pedidoPorId      String               @db.Uuid
  creadoEn         DateTime             @default(now())
  actualizadoEn    DateTime             @updatedAt
  cobros           Cobro[]

  @@index([organizacionId, estado])
}

enum EstadoCambioPlan {
  PENDIENTE
  APROBADO
  RECHAZADO
}

/// HU-1706 · Una subida de plan a mitad de período: la diferencia prorrateada por día (RN-18-7) y su pago.
model CambioPlan {
  id                String           @id @default(uuid()) @db.Uuid
  organizacionId    String           @db.Uuid
  organizacion      Organizacion     @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  suscripcionId     String           @db.Uuid
  suscripcion       Suscripcion      @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  planOrigenId      String           @db.Uuid
  planOrigen        Plan             @relation("CambioPlanOrigen", fields: [planOrigenId], references: [id], onDelete: Restrict)
  planDestinoId     String           @db.Uuid
  planDestino       Plan             @relation("CambioPlanDestino", fields: [planDestinoId], references: [id], onDelete: Restrict)
  ciclo             CicloSuscripcion
  /// El precio del plan nuevo por el ciclo, sin IGV, que pasa a ser el precio pactado al aprobarse.
  precioNuevoSinIgv Int
  diasRestantes     Int
  diasPeriodo       Int
  /// En la moneda de la suscripción, con dos decimales.
  diferenciaSinIgv  Decimal          @db.Decimal(10, 2)
  igv               Decimal          @db.Decimal(10, 2)
  total             Decimal          @db.Decimal(10, 2)
  moneda            String
  pasarela          String
  estado            EstadoCambioPlan @default(PENDIENTE)
  /// El evento de la pasarela que lo resolvió (idempotencia, RN-18-3).
  eventoPagoId      String?          @unique
  motivoRechazo     String?
  pedidoPorId       String           @db.Uuid
  creadoEn          DateTime         @default(now())
  actualizadoEn     DateTime         @updatedAt
  cobros            Cobro[]

  @@index([organizacionId, estado])
}

/// Cómo se ofrece cada pasarela en el pago: nombre, mostrar/ocultar, orden y modo. Las llaves y secretos nunca van aquí:
/// solo en variables de entorno.
model PasarelaConfig {
  /// pruebas, culqi o stripe.
  codigo        String       @id
  nombre        String
  visible       Boolean      @default(false)
  orden         Int          @default(0)
  modo          ModoPasarela @default(pruebas)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
}
