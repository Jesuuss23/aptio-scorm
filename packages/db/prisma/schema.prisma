// Esquema físico de la base de datos (PostgreSQL) — Aptio SCORM
// El documento del curso vive en Curso.documento (JSONB) y valida contra
// packages/schema/esquemas/curso-v0.schema.json (v0.2).
// Las tablas guardan lo que necesita consultas, permisos, costos o historial.
//
// Multi-organización (ADR-012): las tablas raíz de cada organización llevan
// `organizacionId`; las tablas hijas (kit, versiones, etapas, narraciones…)
// heredan el aislamiento por la relación con su padre. Ver docs/12-modelo-datos.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Organizaciones (ADR-012) ----------

enum EstadoOrganizacion {
  ACTIVA
  SOLO_LECTURA // cobranza vencida (HU-1708)
  CANCELADA
}

model Organizacion {
  id            String             @id @default(uuid()) @db.Uuid
  nombre        String
  slug          String             @unique
  ruc           String? // para comprobantes SUNAT (HU-1707)
  estado        EstadoOrganizacion @default(ACTIVA)
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt

  usuarios          Usuario[]
  clientes          Cliente[]
  proyectos         Proyecto[]
  cursos            Curso[]
  generaciones      Generacion[]
  trabajosIA        TrabajoIA[]
  recursos          Recurso[]
  exportaciones     Exportacion[]
  mediciones        MedicionProceso[]
  parametrosNegocio ParametrosNegocio?
  conexionesIA      ConfigProveedor[]
  auditoria         Auditoria[]
  subidas           Subida[]
}

// ---------- Personas y acceso ----------

enum Rol {
  SUPERADMIN // plataforma; sin organización (ADR-011, HU-1501)
  ADMINISTRADOR
  DISENADOR_INSTRUCCIONAL
  DISENADOR_GRAFICO
  PRODUCTOR
  REVISOR_CLIENTE
}

model Usuario {
  id               String    @id @default(uuid()) @db.Uuid
  organizacionId   String?   @db.Uuid
  email            String    @unique
  nombre           String
  hashClave        String? // argon2id; null si solo ingresa con Google (ADR-009)
  googleSub        String?   @unique // identificador de Google (OpenID Connect), se vincula por correo verificado
  emailVerificado  Boolean   @default(false)
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime? // 5 intentos fallidos = 15 minutos
  versionSesion    Int       @default(0) // sube al cambiar la clave o desactivar: invalida las sesiones abiertas
  rol              Rol
  clienteId        String?   @db.Uuid // solo para REVISOR_CLIENTE
  // organizacionId es null solo para SUPERADMIN
  activo           Boolean   @default(true)
  creadoEn         DateTime  @default(now())
  ultimoIngreso    DateTime?

  cliente              Cliente?      @relation(fields: [clienteId], references: [id])
  proyectos            Proyecto[]    @relation("ProyectoCreador")
  comentarios          Comentario[]
  comentariosResueltos Comentario[]  @relation("ComentarioResuelto")
  propuestasResueltas  Propuesta[]   @relation("PropuestaResuelta")
  exportaciones        Exportacion[]
  auditoria            Auditoria[]
  tokens               TokenAcceso[]
  organizacion         Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId])
}

// ---------- Clientes y kits de marca ----------

model Cliente {
  id                      String   @id @default(uuid()) @db.Uuid
  organizacionId          String   @db.Uuid
  nombre                  String
  retencionDocumentosDias Int      @default(180) // días tras la entrega para borrar documentos fuente del cliente (ADR-009)
  lmsHabitual             String?
  idiomas                 String[] @default(["es"])
  notas                   String?
  activo                  Boolean  @default(true)
  creadoEn                DateTime @default(now())

  kit           KitMarca?
  proyectos     Proyecto[]
  recursos      Recurso[]
  glosario      GlosarioTermino[]
  pronunciacion PronunciacionTermino[]
  fichasLms     FichaCompatibilidad[]
  usuarios      Usuario[]
  organizacion  Organizacion           @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId])
}

model KitMarca {
  id              String   @id @default(uuid()) @db.Uuid
  clienteId       String   @unique @db.Uuid
  estilo          String // Industrial, Corporativo, Institucional, Infantil aula, Salud…
  paleta          Json // { primario, secundario, acento, fondo, texto } en hex
  tipografias     Json // { titulos, textos } con licencia
  logoRecursoId   String?  @db.Uuid
  personaje       Json? // { recursoId, nombre, capas[], bocasDisponibles[] }
  voces           Json // { es: { proveedor, voz, velocidad }, en: {...} }
  patronPreferido String? // HU-1103 · patrón de navegación preferido del cliente (clasico, historias, mapa…)
  version         Int      @default(1)
  actualizadoEn   DateTime @updatedAt

  cliente         Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pantallasModelo PantallaModelo[]
}

model PantallaModelo {
  id                 String  @id @default(uuid()) @db.Uuid
  kitId              String  @db.Uuid
  disposicion        String // portada, idea, lista, clasificar… (enum del esquema del curso)
  nombre             String
  definicion         Json // componentes, posiciones relativas y estilos base
  miniaturaRecursoId String? @db.Uuid
  orden              Int     @default(0)
  activa             Boolean @default(true)

  kit KitMarca @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@index([kitId, disposicion])
}

model GlosarioTermino {
  id         String  @id @default(uuid()) @db.Uuid
  clienteId  String  @db.Uuid
  termino    String
  traduccion String?
  noTraducir Boolean @default(false)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, termino])
}

model PronunciacionTermino {
  id          String @id @default(uuid()) @db.Uuid
  clienteId   String @db.Uuid
  idioma      String // es | en
  escrito     String
  pronunciado String // texto o SSML

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, idioma, escrito])
}

model FichaCompatibilidad {
  id                   String   @id @default(uuid()) @db.Uuid
  clienteId            String   @db.Uuid
  lmsNombre            String
  lmsVersion           String?
  limiteSubidaMb       Int?
  notas                String?
  resultadoDiagnostico Json? // lo que devolvió el modo diagnóstico del paquete
  actualizadoEn        DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// ---------- Proyectos, material y curso ----------

enum EstadoProyecto {
  BORRADOR
  GENERANDO
  REVISION
  ENTREGADO
  ARCHIVADO
}

model Proyecto {
  id                    String         @id @default(uuid()) @db.Uuid
  organizacionId        String         @db.Uuid
  clienteId             String         @db.Uuid
  nombre                String
  estado                EstadoProyecto @default(BORRADOR)
  idiomas               String[]       @default(["es"])
  modoIdioma            String         @default("unico") // unico | separados | mismo-paquete
  publico               String?
  tono                  String?
  pantallasObjetivo     Int?
  porcentajeActividades Int?
  datosTecnicos         Json? // OPCIONAL: { lms, formato, horasCapacitacion, porcentajeScorm, fechaEntrega }
  creadoPorId           String         @db.Uuid
  creadoEn              DateTime       @default(now())
  actualizadoEn         DateTime       @updatedAt

  cliente      Cliente           @relation(fields: [clienteId], references: [id])
  creadoPor    Usuario           @relation("ProyectoCreador", fields: [creadoPorId], references: [id])
  materiales   MaterialFuente[]
  curso        Curso?
  generaciones Generacion[]
  trabajosIA   TrabajoIA[]
  mediciones   MedicionProceso[]
  recursos     Recurso[]
  organizacion Organizacion      @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([clienteId, estado])
  @@index([organizacionId, estado])
}

enum TipoMaterial {
  PDF
  WORD
  POWERPOINT
  VIDEO
  AUDIO
  IMAGEN
  TEMA
}

model MaterialFuente {
  id            String       @id @default(uuid()) @db.Uuid
  proyectoId    String       @db.Uuid
  tipo          TipoMaterial
  recursoId     String?      @db.Uuid // null cuando tipo = TEMA
  tema          String?
  estado        String       @default("pendiente") // pendiente | procesando | listo | error
  paginas       Json? // [{ n, texto, escaneada, posibleInstruccion }]
  transcripcion Json? // [{ desde, hasta, texto }]
  mapaTemas     Json? // [{ tema, paginas, decision: conservar|complementario|omitir, motivo }]
  error         String? // motivo legible si estado = error
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @default(now()) @updatedAt

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model Curso {
  id               String   @id @default(uuid()) @db.Uuid
  organizacionId   String   @db.Uuid
  proyectoId       String   @unique @db.Uuid
  versionEsquema   String // 0.2.0
  documento        Json // documento del curso validado
  version          Int      @default(1) // bloqueo optimista
  actualizadoEn    DateTime @updatedAt
  actualizadoPorId String?  @db.Uuid

  proyecto      Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  versiones     CursoVersion[]
  propuestas    Propuesta[]
  observaciones Observacion[]
  narraciones   Narracion[]
  traducciones  Traduccion[]
  exportaciones Exportacion[]
  comentarios   Comentario[]
  organizacion  Organizacion   @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
}

model CursoVersion {
  id          String   @id @default(uuid()) @db.Uuid
  cursoId     String   @db.Uuid
  version     Int
  documento   Json
  motivo      String // "generación", "propuesta IA aplicada", "edición", "restauración"
  creadoPorId String?  @db.Uuid
  creadoEn    DateTime @default(now())

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([cursoId, version])
}

// ---------- Generación e IA ----------

enum EstadoTrabajo {
  EN_COLA
  EN_CURSO
  COMPLETADO
  ERROR
  CANCELADO
}

model Generacion {
  id             String        @id @default(uuid()) @db.Uuid
  organizacionId String        @db.Uuid
  proyectoId     String        @db.Uuid
  estado         EstadoTrabajo @default(EN_COLA)
  parametros     Json // pantallas, idiomas, público, tono, % actividades, kit
  costoUsd       Decimal       @default(0) @db.Decimal(10, 4)
  iniciadoPorId  String        @db.Uuid
  creadoEn       DateTime      @default(now())
  terminadoEn    DateTime?

  proyecto     Proyecto          @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  etapas       GeneracionEtapa[]
  trabajos     TrabajoIA[]
  organizacion Organizacion      @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
}

enum EtapaGeneracion {
  RESUMEN_MATERIAL
  OBJETIVOS_ESTRUCTURA
  STORYBOARD_GUION
  PANTALLAS
  ILUSTRACIONES
  VOZ_ES
  BOCA
  SUBTITULOS
  VERSION_EN
  CONTROL_CALIDAD
  PAQUETE
}

model GeneracionEtapa {
  id           String          @id @default(uuid()) @db.Uuid
  generacionId String          @db.Uuid
  etapa        EtapaGeneracion
  orden        Int
  estado       EstadoTrabajo   @default(EN_COLA)
  detalle      Json? // resumen para la pantalla de Producción
  inicio       DateTime?
  fin          DateTime?
  costoUsd     Decimal         @default(0) @db.Decimal(10, 4)

  generacion Generacion @relation(fields: [generacionId], references: [id], onDelete: Cascade)

  @@unique([generacionId, etapa])
}

enum TareaProveedor {
  TEXTO
  PANTALLAS
  IMAGEN
  VOZ
  BOCA
  TRADUCCION
  TRANSCRIPCION
  CALIDAD
}

model TrabajoIA {
  id             String         @id @default(uuid()) @db.Uuid
  organizacionId String         @db.Uuid
  proyectoId     String?        @db.Uuid
  generacionId   String?        @db.Uuid
  tarea          String // IA-01 … IA-14
  tipo           TareaProveedor
  proveedor      String
  modelo         String
  versionPrompt  String?
  tokensEntrada  Int?
  tokensSalida   Int?
  caracteres     Int?
  imagenes       Int?
  segundosAudio  Int?
  costoUsd       Decimal        @default(0) @db.Decimal(10, 4)
  estado         EstadoTrabajo  @default(EN_COLA)
  intentos       Int            @default(0)
  error          String?
  duracionMs     Int?
  /// HU-0206 · Lo que deja una tarea sin curso ni proyecto, p. ej. la propuesta de kit (IA-18) con su cliente y evidencias.
  resultado      Json?
  creadoEn       DateTime       @default(now())

  proyecto     Proyecto?    @relation(fields: [proyectoId], references: [id])
  generacion   Generacion?  @relation(fields: [generacionId], references: [id])
  propuestas   Propuesta[]
  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([proyectoId, creadoEn])
  @@index([tipo, creadoEn])
  @@index([organizacionId, creadoEn])
}

enum EstadoPropuesta {
  PENDIENTE
  APLICADA
  DESCARTADA
  VENCIDA // el curso cambió y la propuesta ya no aplica
}

model Propuesta {
  id            String          @id @default(uuid()) @db.Uuid
  cursoId       String          @db.Uuid
  pantallaId    String? // id de pantalla dentro del documento
  tipo          String // mas-visual, menos-texto, actividad, variantes, alineacion, patron-navegacion, traduccion…
  titulo        String
  descripcion   String
  cambios       Json // JSON Patch (RFC 6902) sobre el documento del curso
  versionBase   Int // versión del curso sobre la que se calculó
  estado        EstadoPropuesta @default(PENDIENTE)
  trabajoIAId   String?         @db.Uuid
  resueltoPorId String?         @db.Uuid
  resueltoEn    DateTime?
  creadoEn      DateTime        @default(now())

  curso       Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  trabajoIA   TrabajoIA? @relation(fields: [trabajoIAId], references: [id])
  resueltoPor Usuario?   @relation("PropuestaResuelta", fields: [resueltoPorId], references: [id])

  @@index([cursoId, estado])
}

enum TipoObservacion {
  CALIDAD
  ALINEACION
  IDIOMA
  ACCESIBILIDAD
  MATERIAL_FALTANTE
}

model Observacion {
  id         String          @id @default(uuid()) @db.Uuid
  cursoId    String          @db.Uuid
  pantallaId String?
  tipo       TipoObservacion
  severidad  String // info | aviso | bloquea-entrega
  mensaje    String
  origen     String // regla | ia | usuario | tiempo
  resuelta   Boolean         @default(false)
  // HU-0505 · Categoría que muestra Revisión (ortografia, longitud, accesibilidad…), sugerencia de IA-12 y ruta del texto.
  categoria  String?
  sugerencia String?
  ruta       String?
  creadoEn   DateTime        @default(now())

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@index([cursoId, resuelta])
}

// ---------- Recursos, voz e idiomas ----------

enum TipoRecurso {
  IMAGEN
  SVG
  AUDIO
  VIDEO
  DOCUMENTO
  FUENTE
  SUBTITULO
  PAQUETE
}

enum OrigenRecurso {
  BIBLIOTECA
  GENERADO
  SUBIDO
  CLIENTE
}

model Recurso {
  id             String        @id @default(uuid()) @db.Uuid
  organizacionId String        @db.Uuid
  clienteId      String?       @db.Uuid
  proyectoId     String?       @db.Uuid
  tipo           TipoRecurso
  origen         OrigenRecurso
  claveS3        String        @unique
  mime           String
  bytes          BigInt
  ancho          Int?
  alto           Int?
  duracionMs     Int?
  hash           String // sha256 del contenido
  nombre         String
  alt            Json? // { es, en }
  licencia       String? // condición de uso del proveedor (ADR-010)
  proveedor      String? // recraft | firefly | google | ... (solo GENERADO)
  modelo         String? // modelo y versión usados (solo GENERADO)
  eliminarEn     DateTime? // borrado programado de documentos del cliente (ADR-009)
  metadatos      Json? // prompt de generación, capas SVG, etc.
  creadoEn       DateTime      @default(now())

  cliente      Cliente?     @relation(fields: [clienteId], references: [id])
  proyecto     Proyecto?    @relation(fields: [proyectoId], references: [id])
  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([clienteId, tipo])
  @@index([organizacionId, tipo])
  @@index([eliminarEn])
}

/// Subida pedida con URL firmada y aún no confirmada (HU-1404). Al confirmar se verifica el tipo real y se crea el Recurso.
model Subida {
  id             String        @id @default(uuid()) @db.Uuid
  organizacionId String        @db.Uuid
  usuarioId      String        @db.Uuid
  clienteId      String?       @db.Uuid
  proyectoId     String?       @db.Uuid
  origen         OrigenRecurso
  nombre         String
  mime           String
  bytes          BigInt
  claveS3        String        @unique
  expira         DateTime
  recursoId      String?       @db.Uuid // se llena al confirmar
  creadoEn       DateTime      @default(now())

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId, usuarioId])
}

enum EstadoNarracion {
  ACTUALIZADA
  DESACTUALIZADA
  GENERANDO
  ERROR
}

model Narracion {
  id                 String          @id @default(uuid()) @db.Uuid
  cursoId            String          @db.Uuid
  pantallaId         String
  idioma             String
  textoHash          String // sha256 del texto + diccionario + voz: si cambia, queda DESACTUALIZADA
  origen             String // tts | grabacion
  voz                String?
  velocidad          Decimal?        @db.Decimal(3, 2)
  audioRecursoId     String?         @db.Uuid
  subtituloRecursoId String?         @db.Uuid
  bocas              Json? // [[ms, "A".."X"], …]
  estado             EstadoNarracion @default(DESACTUALIZADA)
  actualizadoEn      DateTime        @updatedAt

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([cursoId, pantallaId, idioma])
}

enum EstadoTraduccion {
  PENDIENTE
  TRADUCIDA_IA
  REVISADA
  DESBORDE
}

model Traduccion {
  id              String           @id @default(uuid()) @db.Uuid
  cursoId         String           @db.Uuid
  ruta            String // JSON Pointer al texto dentro del documento
  idioma          String
  textoOrigenHash String
  estado          EstadoTraduccion @default(PENDIENTE)
  propuesta       String? // HU-0803 · versión corta de la IA para un texto en Desborde
  actualizadoEn   DateTime         @updatedAt

  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([cursoId, ruta, idioma])
}

// ---------- Revisión y entrega ----------

/// HU-0506 · Comentario de una pantalla (revisor del cliente o equipo). El texto no se edita ni se borra; el equipo lo
/// resuelve o lo reabre, con quién y cuándo.
model Comentario {
  id            String    @id @default(uuid()) @db.Uuid
  cursoId       String    @db.Uuid
  pantallaId    String
  autorId       String    @db.Uuid
  texto         String
  resuelto      Boolean   @default(false)
  resueltoPorId String?   @db.Uuid
  resueltoEn    DateTime?
  creadoEn      DateTime  @default(now())

  curso       Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  autor       Usuario  @relation(fields: [autorId], references: [id])
  resueltoPor Usuario? @relation("ComentarioResuelto", fields: [resueltoPorId], references: [id])

  @@index([cursoId, pantallaId])
}

enum FormatoExportacion {
  SCORM12
  SCORM2004
  CMI5
  HTML
  JSON
  KIT_GAMIFICACION
}

model Exportacion {
  id                 String             @id @default(uuid()) @db.Uuid
  organizacionId     String             @db.Uuid
  cursoId            String             @db.Uuid
  versionCurso       Int
  formato            FormatoExportacion
  perfilLms          String             @default("generico") // generico | moodle | blackboard | chamilo | canvas
  modoIdioma         String
  estado             EstadoTrabajo      @default(EN_COLA)
  bytes              BigInt?
  informe            Json? // validaciones, advertencias, suspend_data estimado
  motivo             String? // HU-1202: por qué terminó en ERROR
  incluirDiagnostico Boolean            @default(true) // HU-1204: modo diagnóstico dentro del paquete
  recursoId          String?            @db.Uuid // ZIP en S3
  creadoPorId        String             @db.Uuid
  creadoEn           DateTime           @default(now())

  curso        Curso        @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  creadoPor    Usuario      @relation(fields: [creadoPorId], references: [id])
  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
}

// ---------- Configuración, negocio y auditoría ----------

/// HU-1304 · Una conexión por organización y tarea; las claves van en variables de entorno (RN-13-3).
model ConfigProveedor {
  id                    String         @id @default(uuid()) @db.Uuid
  organizacionId        String?        @db.Uuid
  organizacion          Organizacion?  @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  tarea                 TareaProveedor
  proveedor             String
  modelo                String
  parametros            Json? // sin claves: las claves van en variables de entorno
  costoUnitario         Json? // precios vigentes para estimar
  limiteGastoMensualUsd Decimal?       @db.Decimal(10, 2)
  activo                Boolean        @default(true)
  actualizadoEn         DateTime       @updatedAt

  @@unique([organizacionId, tarea])
}

model ParametrosNegocio {
  id             String        @id @default(uuid())
  /// HU-1303 · Un registro por organización; el antiguo «unico» queda sin organización y no se usa.
  organizacionId String?       @unique @db.Uuid
  datos          Json // precio actual, precio competencia, tarifa hora, personas, horas productivas, licencias, tipo de cambio…
  actualizadoEn  DateTime      @updatedAt
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
}

model MedicionProceso {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  proyectoRef    String // nombre del proyecto medido (puede ser anterior a la herramienta)
  /// HU-1303 · Proyecto de la herramienta, si el medido existe en ella.
  proyectoId     String?      @db.Uuid
  escenario      String // hoy | generador
  etapa          String
  horas          Decimal      @db.Decimal(6, 2)
  notas          String?
  registradoPor  String?
  creadoEn       DateTime     @default(now())
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  proyecto       Proyecto?    @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  @@index([proyectoRef, escenario])
  @@index([organizacionId])
}

model Auditoria {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String?  @db.Uuid
  usuarioId      String?  @db.Uuid
  accion         String
  entidad        String
  entidadId      String?
  datos          Json?
  creadoEn       DateTime @default(now())

  usuario      Usuario?      @relation(fields: [usuarioId], references: [id])
  organizacion Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([entidad, entidadId])
}

// Invitaciones y cambios de clave (ADR-009). Se guarda solo el hash del token.
model TokenAcceso {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @db.Uuid
  tipo      String // INVITACION | RESTABLECER_CLAVE
  hashToken String    @unique
  expira    DateTime
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
}

/// HU-1403 · Estado de una copia de seguridad diaria (o pedida con «Respaldar ahora»).
enum EstadoRespaldo {
  EN_CURSO
  EXITOSO
  FALLIDO
  /// Pasó la retención de 14 días: sus objetos se borraron del bucket de respaldos.
  EXPIRADO
}

/// HU-1403 · Una copia de seguridad de la plataforma: volcado de PostgreSQL y copia de los objetos de S3 (CP-108).
model Respaldo {
  id              String         @id @default(uuid()) @db.Uuid
  /// Inicio de la copia; da nombre a su carpeta en el bucket de respaldos.
  fecha           DateTime       @default(now())
  estado          EstadoRespaldo @default(EN_CURSO)
  /// programado (03:00 de Lima) o manual («Respaldar ahora»).
  origen          String         @default("programado")
  solicitadoPorId String?        @db.Uuid
  /// Bucket de respaldos y carpeta de esta copia (volcado, objetos y manifiesto).
  bucket          String?
  ubicacion       String?
  claveVolcado    String?
  objetos         Int?
  tamanoBytes     BigInt?
  duracionMs      Int?
  error           String?
  expiradoEn      DateTime?

  @@index([fecha])
}

/// HU-1502 · Estado de una página del sitio comercial (RN-16-6): un borrador o una programada responden 404 y no
/// entran al sitemap; una programada pasa sola a publicada al llegar `publicarEn`.
enum EstadoPagina {
  BORRADOR
  PROGRAMADA
  PUBLICADA
}

/// HU-1502 · Página del sitio comercial (M16, ADR-011). De la plataforma, sin organización; solo la administra el
/// superadmin. Bloques (HU-1503), SEO (HU-1512) y landings de sector (HU-1514) llegan con sus historias.
model SitioPagina {
  id            String       @id @default(uuid()) @db.Uuid
  /// `/` (inicio) o `/segmento[/segmento…]` con minúsculas, números y guiones.
  ruta          String
  idioma        String       @default("es")
  titulo        String
  estado        EstadoPagina @default(BORRADOR)
  /// Fecha y hora en que se publica sola (solo en PROGRAMADA).
  publicarEn    DateTime?
  /// Última vez que pasó a PUBLICADA.
  publicadaEn   DateTime?
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
  bloques       SitioBloque[]

  @@unique([ruta, idioma])
  @@index([estado, publicarEn])
}

/// Bloque de una página del sitio comercial (HU-1503, REQ-066). El tipo sale
/// del catálogo cerrado `TIPOS_BLOQUE` de `@aptio/schema`; nace oculto (RN-16-2).
model SitioBloque {
  id            String      @id @default(uuid()) @db.Uuid
  paginaId      String      @db.Uuid
  pagina        SitioPagina @relation(fields: [paginaId], references: [id], onDelete: Cascade)
  tipo          String
  /// Posición 0, 1, 2… sin huecos dentro de la página.
  orden         Int
  visible       Boolean     @default(false)
  /// Datos propios del bloque; ocultarlo no los borra (CP-112).
  ajustes       Json?
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  @@index([paginaId, orden])
}

/// Elemento de contenido del sitio comercial (HU-1504, REQ-066, PNT-27): cifras, testimonios, logos, funcionalidades,
/// pasos, LMS y preguntas. Los campos de `datos` los fija `@aptio/schema/sitio-contenido`; nace oculto (RN-16-2).
model SitioElemento {
  id            String   @id @default(uuid()) @db.Uuid
  coleccion     String
  /// Posición 0, 1, 2… sin huecos dentro de la colección.
  orden         Int
  visible       Boolean  @default(false)
  /// HU-1505 · Dato inventado: bloquea publicar en producción mientras esté visible (RN-16-3).
  ficticio      Boolean  @default(false)
  datos         Json
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([coleccion, orden])
}

/// HU-1506 · Enlaces del menú principal y del pie (REQ-066, PNT-25). El menú es plano; el pie tiene
/// columnas (sin padre) con sus enlaces (con padre). Ocultar no borra; borrar una columna borra sus enlaces.
model SitioEnlace {
  id            String        @id @default(uuid()) @db.Uuid
  /// menu | pie
  zona          String
  padreId       String?       @db.Uuid
  padre         SitioEnlace?  @relation("SitioEnlaceHijos", fields: [padreId], references: [id], onDelete: Cascade)
  hijos         SitioEnlace[] @relation("SitioEnlaceHijos")
  texto         String
  /// Ruta interna (/precios, /#testimonios) o https://. Vacía solo en una columna del pie.
  ruta          String?
  /// Posición 0, 1, 2… sin huecos entre hermanos (misma zona y mismo padre).
  orden         Int
  visible       Boolean       @default(false)
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  @@index([zona, padreId, orden])
}

/// HU-1507 · Versión publicada del sitio (REQ-068, RN-16-5): instantánea inmutable del sitio completo. El sitio público
/// sirve solo la última. No se edita ni se borra; restaurar la N crea una nueva con la instantánea de N (CP-119).
model SitioVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  /// 1, 2, 3… sin repetir; la mayor es la que ve el sitio.
  numero             Int      @unique
  /// Páginas publicadas con sus bloques y elementos visibles, y la navegación visible (`@aptio/schema/sitio-versiones`).
  instantanea        Json
  /// Quién publicó; null cuando la publica la plataforma (programada). Sin llave foránea: la versión no cambia aunque se borre el usuario.
  publicadoPorId     String?  @db.Uuid
  publicadoPorNombre String?
  /// produccion | pruebas
  entorno            String
  /// publicacion | pagina | programada | restauracion
  origen             String
  /// Con origen restauracion: el número de la versión restaurada.
  restauradaDe       Int?
  /// HU-1508 · Pre-render del HTML al bucket: en_curso | listo | error.
  prerenderEstado    String   @default("en_curso")
  prerenderEn        DateTime?
  prerenderError     String?
  creadoEn           DateTime @default(now())
}

/// HU-1509 · Ajustes del sitio comercial (REQ-073, PNT-38): una sola fila (`id` = "sitio") con dominio, marca, analítica,
/// WhatsApp, correo de leads y modo mantenimiento, validados con `@aptio/schema/sitio-ajustes`.
model SitioAjustes {
  id               String   @id @default("sitio")
  datos            Json
  actualizadoPorId String?  @db.Uuid
  actualizadoEn    DateTime @updatedAt
}
